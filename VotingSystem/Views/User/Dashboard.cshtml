@model List<VotingSystem.Models.Candidate>
@using Newtonsoft.Json
@{
    ViewBag.Title = "User Dashboard";

    var candidatesByPosition = ViewBag.CandidatesByPosition as Dictionary<string, List<Candidate>> ?? new Dictionary<string, List<Candidate>>();
    var userVotes = ViewBag.UserVotes as List<Vote> ?? new List<Vote>();
    var votingStatus = ViewBag.VotingStatus as string ?? "Closed";
    var positionSettings = ViewBag.PositionSettings as Dictionary<string, int> ?? new Dictionary<string, int>();
    var isVotingOpen = ViewBag.IsVotingOpen ?? false;
    var hasVoted = ViewBag.HasVoted ?? false;
    var activeElection = ViewBag.ActiveElection as string ?? "No Active Election";

 
    var profilePicture = ViewBag.ProfilePicture as string ?? "/images/default-avatar.png";
    var userEmail = ViewBag.UserEmail as string ?? "Not provided";
    var userCourse = ViewBag.UserCourse as string ?? "Not specified";
    var userRole = ViewBag.UserRole as string ?? "User";
    var username = ViewBag.Username as string ?? "User";

    var electionHistory = ViewBag.ElectionHistory as List<Election> ?? new List<Election>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<!-- Profile Modal -->
<div id="profileModal" class="profile-modal">
    <div class="profile-modal-content">
        <div class="profile-modal-header">
            <h3 class="profile-modal-title"><i class="bi bi-person-circle"></i> Your Profile</h3>
            <button class="close-profile-modal" onclick="closeProfileModal()">×</button>
        </div>
        <div class="profile-modal-body">
         
            <div class="profile-picture-section">
                <div class="profile-picture-container">
                    <img id="profilePicture" src="@profilePicture" alt="Profile" class="profile-picture"
                         onerror="this.style.display='none'; document.getElementById('profilePicturePlaceholder').style.display='flex';">
                    <div id="profilePicturePlaceholder" class="profile-picture" style="display: @(string.IsNullOrEmpty(profilePicture) || profilePicture == "/images/default-avatar.png" ? "flex" : "none"); align-items: center; justify-content: center; font-size: 2.5rem; color: white; background: var(--primary-color);">
                        @username.Substring(0, 1).ToUpper()
                    </div>
                    <button class="profile-picture-edit" onclick="document.getElementById('profilePictureInput').click()">
                        📷
                    </button>
                </div>
                <input type="file" id="profilePictureInput" class="file-input" accept="image/*" onchange="handleProfilePictureChange(event)">

                <div class="file-info">
                    Supported formats: JPG, PNG, GIF (Max: 2MB)
                </div>
                <div id="uploadPreview" class="upload-preview" style="display: none;">
                    <img id="previewImage" class="preview-image" alt="Preview">
                    <div style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--text-light);">
                        New profile picture preview
                    </div>
                </div>
            </div>

            <!-- Profile Information -->
            <div class="profile-info-grid">
                <div class="profile-info-item">
                    <span class="profile-info-label">Username:</span>
                    <span class="profile-info-value" id="profileUsername">@username</span>
                </div>
                <div class="profile-info-item">
                    <span class="profile-info-label">Email:</span>
                    <span class="profile-info-value" id="profileEmail">@userEmail</span>
                </div>
                <div class="profile-info-item">
                    <span class="profile-info-label">Course:</span>
                    <span class="profile-info-value" id="profileCourse">@userCourse</span>
                </div>
                <div class="profile-info-item">
                    <span class="profile-info-label">Role:</span>
                    <span class="profile-info-value" id="profileRole">@userRole</span>
                </div>
                <div class="profile-info-item">
                    <span class="profile-info-label">Voting Status:</span>
                    <span class="profile-info-value" id="profileVotingStatus">@(hasVoted ? "✅ Voted" : "❌ Not Voted")</span>
                </div>
            </div>

            <!-- Edit Form -->
            <div class="profile-form">
                <h4 style="color: var(--primary-color); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="bi bi-pen-fill"></i>Edit Profile Information
                </h4>

                <div class="form-group">
                    <label class="form-label" for="editUsername">Username</label>
                    <input type="text" id="editUsername" class="form-input" value="@username" placeholder="Enter your username">
                </div>

                <div class="form-group">
                    <label class="form-label" for="editEmail">Email Address</label>
                    <input type="email" id="editEmail" class="form-input" value="@userEmail" placeholder="Enter your email">
                </div>

                <div class="loading-spinner" id="profileLoading">
                    <div class="spinner"></div>
                    <p style="margin-top: 0.5rem; color: var(--text-light);">Updating profile...</p>
                </div>

                <div class="profile-actions">
                    <button class="btn-cancel" onclick="closeProfileModal()">Cancel</button>
                    <button class="btn-save" onclick="updateProfile()" id="saveProfileBtn">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Election History Modal -->
<div id="electionHistoryModal" class="profile-modal">
    <div class="profile-modal-content" style="max-width: 800px;">
        <div class="profile-modal-header">
            <h3 class="profile-modal-title"><i class="bi bi-hourglass-split"></i>
            Election History</h3>
            <button class="close-profile-modal" onclick="closeElectionHistoryModal()">×</button>
        </div>
        <div class="profile-modal-body">
            @if (electionHistory.Any())
            {
                <div class="election-history-list">
                    @foreach (var election in electionHistory.OrderByDescending(e => e.EndDate))
                    {
                        var totalVotes = election.Candidates?.Sum(c => c.VoteCount) ?? 0;
                        var positions = election.Candidates?.Select(c => c.Position).Distinct().Count() ?? 0;

                        <div class="election-history-item" data-election-id="@election.Id">
                            <div class="election-history-header">
                                <h4>@election.Name</h4>
                                <span class="election-date">@election.EndDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <p class="election-description">@election.Description</p>
                            <div class="election-stats">
                                <span class="stat"><i class="bi bi-people"></i> @(election.Candidates?.Count ?? 0) candidates</span>
                                <span class="stat"><i class="bi bi-check-square"></i> @totalVotes total votes</span>
                                <span class="stat"><i class="bi bi-layers"></i> @positions positions</span>
                            </div>
                            <div class="election-winners">
                                @if (election.Candidates?.Any() == true)
                                {
                                    var winners = election.Candidates
                                    .GroupBy(c => c.Position)
                                    .Select(g => g.OrderByDescending(c => c.VoteCount).First())
                                    .Where(c => c.VoteCount > 0)
                                    .Take(3);

                                    if (winners.Any())
                                    {
                                        <div class="winners-list">
                                            <strong>Top Winners:</strong>
                                            @foreach (var winner in winners)
                                            {
                                                <span class="winner-tag">@winner.Name (@winner.Position)</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <h3>No Election History</h3>
                    <p>Completed election results will appear here once elections are finished.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="dashboard-header">
    <div class="header-content">
        <div class="header-title">
            <span>🗳️</span>
            Voting Dashboard
        </div>
        <div class="user-nav">
           
            <span class="user-welcome">Welcome, @username!</span>
            <div class="user-avatar" onclick="openProfileModal()">
                @if (!string.IsNullOrEmpty(profilePicture) && profilePicture != "/images/default-avatar.png")
                {
                    <img src="@profilePicture" alt="Profile" onerror="this.style.display='none';">
                }
                <span style="@(!string.IsNullOrEmpty(profilePicture) && profilePicture != "/images/default-avatar.png" ? "display: none;" : "display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;")">
                    @username.Substring(0, 1).ToUpper()
                </span>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                <button type="submit" class="logout-btn">Logout</button>
            </form>
        </div>
    </div>
</div>

<div class="dashboard-container">
    <!-- Toast Notification -->
    <div id="toast" class="toast"></div>

    <div class="status-grid">
        <div class="status-card election-info fade-in">
            <div class="card-title">Current Election</div>
            <div class="card-value">@activeElection</div>
            <div class="card-subtitle">Active Election Period</div>
        </div>

        <div class="status-card voting-status fade-in">
            <div class="card-title">Voting Status</div>
            <div class="card-value">@votingStatus</div>
            <div class="status-indicator">
                <div class="status-dot @(isVotingOpen ? "status-open" : "status-closed")"></div>
                <span>@(isVotingOpen ? "Voting is Open" : "Voting is Closed")</span>
            </div>
        </div>

        <div class="status-card user-stats fade-in">
            <div class="card-title">Your Voting Status</div>
            <div class="card-value">@(hasVoted ? "Voted" : "Not Voted")</div>
            <div class="card-subtitle">@userVotes.Count votes cast across @candidatesByPosition.Count positions</div>
        </div>

   
        <div class="status-card history-stats fade-in" onclick="openElectionHistoryModal()" style="cursor: pointer;">
            <div class="card-title">Past Elections</div>
            <div class="card-value">@electionHistory.Count</div>
            <div class="card-subtitle">Click to view history</div>
        </div>
    </div>

    <div class="content-grid">
        <!-- Left Column - Voting Interface -->
        <div class="voting-section">
            <div class="section-header">
                <h2>🗳️ Cast Your Vote</h2>
            </div>
            <div class="section-content">
                @if (!isVotingOpen)
                {
                    <div class="empty-state">
                        <div class="empty-icon">🔒</div>
                        <h3 class="empty-title">Voting is Currently Closed</h3>
                        <p class="empty-description">You cannot cast or change votes while voting is closed. Please check back during the voting period.</p>
                    </div>
                }
                else if (hasVoted)
                {
                    <div class="empty-state">
                        <div class="empty-icon">✅</div>
                        <h3 class="empty-title">Voting Completed</h3>
                        <p class="empty-description">You have already submitted your ballot. Thank you for participating in the election!</p>
                    </div>
                }
                else if (!candidatesByPosition.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">👥</div>
                        <h3 class="empty-title">No Positions Available</h3>
                        <p class="empty-description">There are no positions available for voting in the current election.</p>
                    </div>
                }
                else
                {
                    @foreach (var position in candidatesByPosition.Keys)
                    {
                        var positionVotesAllowed = positionSettings.ContainsKey(position) ? positionSettings[position] : 1;
                        var positionCurrentVotes = userVotes.Where(v => v.Candidate?.Position == position).Count();

                        <div class="position-card">
                            <div class="position-header">
                                <div class="position-title">
                                    <span><i class="bi bi-house"></i></span>
                                    @position
                                </div>
                                <div class="votes-allowed">
                                    @positionVotesAllowed vote@(positionVotesAllowed > 1 ? "s" : "") allowed
                                </div>
                            </div>

                            <div class="candidates-grid">
                                @if (!candidatesByPosition[position].Any())
                                {
                                    <div class="empty-state" style="grid-column: 1 / -1; padding: 2rem;">
                                        <div class="empty-icon">👤</div>
                                        <h4 class="empty-title">No Candidates</h4>
                                        <p class="empty-description">There are no candidates for this position.</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var candidate in candidatesByPosition[position])
                                    {
                                        var isSelected = userVotes.Any(v => v.CandidateId == candidate.Id);

                                        <div class="candidate-card @(isSelected ? "selected" : "")"
                                             data-candidate-id="@candidate.Id"
                                             data-position="@position">

                                            <!-- Candidate Profile Picture -->
                                            <div class="candidate-avatar">
                                                @if (!string.IsNullOrEmpty(candidate.ProfilePicture) && candidate.ProfilePicture != "/images/default-avatar.png")
                                                {
                                                    <img src="@candidate.ProfilePicture" alt="@candidate.Name"
                                                         class="candidate-photo"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                }
                                                <div class="candidate-avatar-fallback"
                                                     style="@(!string.IsNullOrEmpty(candidate.ProfilePicture) && candidate.ProfilePicture != "/images/default-avatar.png" ? "display: none;" : "display: flex;")">
                                                    @candidate.Name.Substring(0, 1).ToUpper()
                                                </div>
                                            </div>

                                            <div class="candidate-info">
                                                <h4 class="candidate-name">@candidate.Name</h4>
                                                @if (!string.IsNullOrEmpty(candidate.PartyList))
                                                {
                                                    <div class="candidate-party">@candidate.PartyList</div>
                                                }
                                                <p class="candidate-description">@candidate.Description</p>
                                                <div class="candidate-stats">
                                                    <span>Total Votes: @candidate.VoteCount</span>
                                                </div>
                                            </div>
                                            <button class="vote-btn @(isSelected ? "success" : "primary")"
                                                    data-candidate-id="@candidate.Id"
                                                    data-position="@position"
                                                    data-candidate-name="@candidate.Name"
                                                    onclick="voteForPosition(this)"
                                                    @(isSelected ? "disabled" : positionCurrentVotes >= positionVotesAllowed ? "disabled" : "")>
                                                @if (isSelected)
                                                {
                                                    <span>✅ Selected</span>
                                                }
                                                else if (positionCurrentVotes >= positionVotesAllowed)
                                                {
                                                    <span>🚫 Vote Limit Reached</span>
                                                }
                                                else
                                                {
                                                    <span>🗳️ Vote for Candidate</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Column - Sidebar -->
        <div class="sidebar">
            <div class="vote-summary-card">
                <div class="summary-header">
                    <h3>
                        <i class="bi bi-card-text"></i>
                        Your Ballot
                    </h3>
                </div>
                <div class="summary-content">
            
                    @if (!userVotes.Any())
                    {
                        <div class="empty-state" style="padding: 2rem 1rem;">
                            <div class="empty-icon">📝</div>
                            <h4 class="empty-title">No Votes Selected</h4>
                            <p class="empty-description">Select candidates from the positions to build your ballot.</p>
                        </div>
                    }
                    else
                    {
                        <div class="selected-candidates-list">
                            @foreach (var vote in userVotes)
                            {
                                <div class="selected-candidate-item">
                                    <div class="candidate-details">
                                        <h4>@vote.Candidate?.Name</h4>
                                        <div class="candidate-position">@vote.Candidate?.Position</div>
                                        @if (!string.IsNullOrEmpty(vote.Candidate?.PartyList))
                                        {
                                            <div class="candidate-party-small">@vote.Candidate.PartyList</div>
                                        }
                                    </div>
                                    <button class="remove-btn"
                                            onclick="removeCandidate(@vote.CandidateId, '@vote.Candidate?.Position', '@vote.Candidate?.Name.Replace("'", "\\'")')">
                                        ×
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="vote-actions">
                            <button class="vote-btn" style="background: #6c757d; color: white;" onclick="clearAllVotes()">
                                 Clear All
                            </button>
                            <button class="vote-btn primary" onclick="submitVotes()" id="submitVotesBtn">
                                Submit Ballot
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Results Preview Section -->
            <div class="results-card">
                <div class="results-header">
                    <h3>
                        <i class="bi bi-bar-chart-line-fill"></i>
                        Live Results
                    </h3>
                </div>
                <div class="results-content">
                    @if (!candidatesByPosition.Any())
                    {
                        <div class="empty-state" style="padding: 1.5rem 1rem;">
                            <div class="empty-icon">📈</div>
                            <p class="empty-description">Results will appear here once voting begins.</p>
                        </div>
                    }
                    else
                    {
                        <div class="results-grid">
                            @{
                                var positionsToShow = candidatesByPosition.Keys.Take(3);
                            }
                            @foreach (var position in positionsToShow)
                            {
                                var candidates = candidatesByPosition[position].OrderByDescending(c => c.VoteCount).ToList();
                                var winner = candidates.FirstOrDefault();
                                var totalVotes = candidates.Sum(c => c.VoteCount);

                                <div class="result-item">
                                    <div class="result-position">
                                        <span><i class="bi bi-bank"></i></span>
                                        @position
                                    </div>
                                    @if (winner != null && winner.VoteCount > 0)
                                    {
                                        <div class="winner-card">
                                            <!-- Winner Profile Picture -->
                                            <div class="winner-avatar">
                                                @if (!string.IsNullOrEmpty(winner.ProfilePicture) && winner.ProfilePicture != "/images/default-avatar.png")
                                                {
                                                    <img src="@winner.ProfilePicture" alt="@winner.Name"
                                                         class="winner-photo"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                }
                                                <div class="winner-avatar-fallback"
                                                     style="@(!string.IsNullOrEmpty(winner.ProfilePicture) && winner.ProfilePicture != "/images/default-avatar.png" ? "display: none;" : "display: flex;")">
                                                    @winner.Name.Substring(0, 1).ToUpper()
                                                </div>
                                            </div>

                                            <div class="winner-name">@winner.Name</div>
                                            @if (!string.IsNullOrEmpty(winner.PartyList))
                                            {
                                                <div style="color: var(--primary-color); font-size: 0.9em; margin-bottom: 5px;">@winner.PartyList</div>
                                            }
                                            <div class="winner-votes">
                                                @winner.VoteCount vote@(winner.VoteCount != 1 ? "s" : "")
                                                @if (totalVotes > 0)
                                                {
                                                    var percentage = (winner.VoteCount * 100.0) / totalVotes;
                                                    <text>(@percentage.ToString("0.0")%)</text>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-state" style="padding: 1rem;">
                                            <p class="empty-description">No votes cast yet</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (candidatesByPosition.Keys.Count > 3)
                        {
                            <div style="text-align: center; margin-top: 1rem;">
                                <small style="color: var(--text-light);">
                                    Showing top 3 of @candidatesByPosition.Keys.Count positions
                                </small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
  
    let isVotingOpen = @Json.Serialize(isVotingOpen);

        // Election History Modal Functions
        function openElectionHistoryModal() {
            const modal = document.getElementById('electionHistoryModal');
            if (modal) {
                modal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            }
        }

        function closeElectionHistoryModal() {
            const modal = document.getElementById('electionHistoryModal');
            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }
              // Close modals when clicking outside
        window.onclick = function(event) {
            const profileModal = document.getElementById('profileModal');
            const historyModal = document.getElementById('electionHistoryModal');

            if (event.target === profileModal) {
                closeProfileModal();
            }
            if (event.target === historyModal) {
                closeElectionHistoryModal();
            }
        }

    // Simple voting function with page reload
    async function voteForPosition(buttonElement) {
        if (!isVotingOpen) {
            showToast('❌ Voting is currently closed', 'error');
            return;
        }

        const candidateId = parseInt(buttonElement.getAttribute('data-candidate-id'));
        const candidateName = buttonElement.getAttribute('data-candidate-name');
        const originalText = buttonElement.innerHTML;

        // Show loading state
        buttonElement.innerHTML = '⏳ Voting...';
        buttonElement.disabled = true;

        try {
            const response = await fetch('/User/VoteForPosition', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ candidateId: candidateId })
            });

            const data = await response.json();

            if (data.success) {
                showToast(`✅ Voted for ${candidateName}`, 'success');
                // Reload the page to ensure UI is synchronized
                setTimeout(() => {
                    location.reload();
                }, 1000);
            } else {
                showToast(`❌ ${data.message}`, 'error');
                buttonElement.innerHTML = originalText;
                buttonElement.disabled = false;
            }
        } catch (error) {
            console.error('Error voting:', error);
            showToast('❌ Network error while voting', 'error');
            buttonElement.innerHTML = originalText;
            buttonElement.disabled = false;
        }
    }

    // Simple remove vote function with page reload
    async function removeCandidate(candidateId, position, candidateName) {
        if (!isVotingOpen) {
            showToast('❌ Voting is currently closed', 'error');
            return;
        }

        try {
            const response = await fetch('/User/ClearVote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    position: position,
                    candidateId: candidateId
                })
            });

            const data = await response.json();

            if (response.ok && data.success) {
                showToast(`🗑️ Removed vote for ${candidateName}`, 'warning');
                // Reload the page
                setTimeout(() => {
                    location.reload();
                }, 1000);
            } else {
                showToast(`❌ ${data.message}`, 'error');
            }
        } catch (error) {
            console.error('Error removing vote:', error);
            showToast('❌ An error occurred while removing vote', 'error');
        }
    }

    // Simple clear all votes with page reload
    async function clearAllVotes() {
        if (!isVotingOpen) {
            showToast('❌ Voting is currently closed', 'error');
            return;
        }

        if (!confirm('Are you sure you want to clear all your votes?')) {
            return;
        }

        const clearBtn = event.target;
        const originalText = clearBtn.innerHTML;

        clearBtn.innerHTML = '⏳ Clearing...';
        clearBtn.disabled = true;

        try {
            // Get all positions from the page
            const positions = [];
            document.querySelectorAll('.position-card').forEach(card => {
                const position = card.querySelector('.position-title').textContent.replace('🏛️', '').trim();
                if (position) positions.push(position);
            });

            let clearSuccess = true;

            // Clear votes for each position
            for (const position of positions) {
                const response = await fetch('/User/ClearVote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ position: position })
                });

                const data = await response.json();
                if (!data.success) {
                    clearSuccess = false;
                }
            }

            if (clearSuccess) {
                showToast('🗑️ All votes cleared', 'warning');
                // Reload the page
                setTimeout(() => {
                    location.reload();
                }, 1000);
            } else {
                showToast('❌ Some votes could not be cleared', 'error');
                clearBtn.innerHTML = originalText;
                clearBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error clearing votes:', error);
            showToast('❌ An error occurred while clearing votes', 'error');
            clearBtn.innerHTML = originalText;
            clearBtn.disabled = false;
        }
    }

    // Simple submit ballot with page reload
    async function submitVotes() {
        if (!isVotingOpen) {
            showToast('❌ Voting is currently closed', 'error');
            return;
        }

        if (!confirm('Are you sure you want to submit your votes? You cannot change them after submission.')) {
            return;
        }

        const submitBtn = document.getElementById('submitVotesBtn');
        const originalText = submitBtn.innerHTML;

        submitBtn.innerHTML = '⏳ Submitting...';
        submitBtn.disabled = true;

        try {
            const response = await fetch('/User/SubmitBallot', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const data = await response.json();

            if (response.ok) {
                showToast('✅ Your votes have been submitted successfully!', 'success');
                setTimeout(() => location.reload(), 2000);
            } else {
                if (data.missingPositions) {
                    showToast(`❌ ${data.message}\n\nMissing: ${data.missingPositions.join(', ')}`, 'error');
                } else {
                    showToast(`❌ ${data.message}`, 'error');
                }
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error submitting votes:', error);
            showToast('❌ Network error while submitting votes', 'error');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    }

