@model List<VotingSystem.Models.Candidate>
@{
    ViewBag.Title = "Admin Dashboard";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">



<div class="header">
    <h2>Admin Dashboard </h2>
    <div class="admin-badge"> @User.Identity.Name</div>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="logout-button">
            <i class="bi bi-box-arrow-right"></i>
            Logout</button>
    </form>
</div>

<div class="dashboard-container">

    <div id="toast" class="toast"></div>

    <!-- Voting Controls -->
    <div class="voting-controls">
        <div class="voting-status">
            <div class="status-indicator">
                <div id="statusDot" class="status-dot @((ViewBag.VotingStatus ?? "Closed") == "Open" ? "status-open" : "status-closed")"></div>
                <span id="statusText">Voting is @(ViewBag.VotingStatus ?? "Closed")</span>
            </div>
            <div class="voting-buttons">
                <button id="openVotingBtn" class="voting-btn btn-open">
                    Open Voting
                </button>
                <button id="closeVotingBtn" class="voting-btn btn-close">
                   Close Voting
                </button>
                <button id="settingsBtn" class="voting-btn btn-settings">
                    Voting Settings
                </button>
            </div>
        </div>

        <div id="configPanel" class="config-panel-enhanced">
            <div class="config-header-enhanced">
                <div class="config-title-section">
                    <div class="config-icon">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <div>
                        <h4 class="config-title">Voting Configuration</h4>
                        <p class="config-subtitle">Configure voting rules for each position</p>
                    </div>
                </div>
                <button class="close-config-enhanced" onclick="closeConfigPanel()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="config-content">
                <div class="config-info-card">
                    <i class="bi bi-info-circle"></i>
                    <p>Configure how many candidates users can vote for in each position.</p>
                </div>

                <div id="positionConfigs" class="position-configs-container">
                    @{
                        var positions = Model.Select(c => c.Position).Distinct().OrderBy(p => p);
                        var positionSettings = ViewBag.PositionSettings as Dictionary<string, int> ?? new Dictionary<string, int>();
                    }

                    @foreach (var position in positions)
                    {
                        var votesAllowed = positionSettings.ContainsKey(position) ? positionSettings[position] : 1;
                        var candidateCount = Model.Count(c => c.Position == position);

                        <div class="position-config-card">
                            <div class="position-config-header">
                                <div class="position-info">
                                    <div class="position-icon">
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                    <div class="position-details">
                                        <h5 class="position-name">@position</h5>
                                        <div class="position-meta">
                                            <span class="meta-item">
                                                <i class="bi bi-people"></i>
                                                @candidateCount candidate@(candidateCount != 1 ? "s" : "")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="votes-control">
                                    <label class="votes-label">Votes Allowed</label>
                                    <div class="votes-input-container">
                                        <button class="votes-btn votes-decrement" type="button" onclick="decrementVotes(this)">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number"
                                               class="votes-allowed-input-enhanced"
                                               value="@votesAllowed"
                                               min="1"
                                               max="10"
                                               data-position="@position">
                                        <button class="votes-btn votes-increment" type="button" onclick="incrementVotes(this)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="config-actions">
                    <button class="config-reset-btn" onclick="resetConfig()">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset to Default
                    </button>
                    <button id="saveConfigBtn" class="save-config-btn-enhanced" onclick="saveVotingConfig()">
                        <i class="bi bi-check-lg"></i>
                        Save Configuration
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">

        <div class="stat-card warning">
            <span class="stat-label">Pending Approvals</span>
            <span class="stat-number">@(ViewBag.PendingApprovals ?? 0)</span>
        </div>
        <div class="stat-card info">
            <span class="stat-label">Voting Status</span>
            <span class="stat-number">@(ViewBag.VotingStatus ?? "Closed")</span>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="actions-grid">
        <a href="@Url.Action("PendingUsers")" class="action-button approval">
            <i class="fas fa-user-clock" style="font-size: 24px;"></i>
            Pending Approvals
            @if (ViewBag.PendingApprovals > 0)
            {
                <span class="badge badge-warning">@ViewBag.PendingApprovals</span>
            }
        </a>
        <a href="@Url.Action("Create")" class="action-button candidate">
            <i class="fas fa-user-plus" style="font-size: 24px;"></i>
            Add Candidate
        </a>
        <a href="@Url.Action("VoterList")" class="action-button voters">
            <i class="fas fa-users" style="font-size: 24px;"></i>
            View Voters
        </a>
        <a href="@Url.Action("VotingStatistics")" class="action-button stats">
            <i class="fas fa-chart-bar" style="font-size: 24px;"></i>
            View Statistics
        </a>
        <a href="@Url.Action("ElectionManagement")" class="action-button election">
            <i class="bi bi-calendar-event" style="font-size: 24px;"></i>
            Manage Elections
        </a>
    </div>

    <div class="candidate-management-section">
        <!-- Header Section -->
        <div class="management-header">
            <div class="header-content">
                <div class="header-title">
                    <i class="bi bi-people-fill header-icon"></i>
                    <div>
                        <h2>Candidate Management</h2>
                        <p class="header-subtitle">Manage all election candidates and their positions</p>
                    </div>
                </div>
                <div class="header-stats">
                    <div class="stat-badge primary">
                        <i class="bi bi-people"></i>
                        <span>@Model.Count Total Candidates</span>
                    </div>
                    <a href="@Url.Action("Create")" class="add-candidate-btn">
                        <i class="bi bi-plus-circle"></i>
                        Add New Candidate
                    </a>
                </div>
            </div>
        </div>

        @{
            var candidatesByPosition = Model.GroupBy(c => c.Position).OrderBy(g => g.Key);
        }

        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3>No Candidates Yet</h3>
                <p>Start building your election by adding the first candidate</p>
                <a asp-action="Create" class="primary-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add First Candidate
                </a>
            </div>
        }
        else
        {
            <!-- Positions Grid -->
            <div class="positions-grid">
                @foreach (var positionGroup in candidatesByPosition)
                {
                    var votesAllowed = ViewBag.PositionSettings != null && ((Dictionary<string, int>)ViewBag.PositionSettings).ContainsKey(positionGroup.Key)
                    ? ((Dictionary<string, int>)ViewBag.PositionSettings)[positionGroup.Key]
                    : 1;
                    var totalVotes = positionGroup.Sum(c => c.VoteCount);
                    var leadingCandidate = positionGroup.OrderByDescending(c => c.VoteCount).FirstOrDefault();

                    <div class="position-card">
                        <!-- Position Header -->
                        <div class="position-card-header">
                            <div class="position-info">
                                <div class="position-icon">
                                    <i class="bi bi-house-door-fill"></i>
                                </div>
                                <div class="position-details">
                                    <h3 class="position-title">@positionGroup.Key</h3>
                                    <div class="position-meta">
                                        <span class="meta-item">
                                            <i class="bi bi-people"></i>
                                            @positionGroup.Count() candidate@(positionGroup.Count() > 1 ? "s" : "")
                                        </span>
                                        <span class="meta-item">
                                            <i class="bi bi-check-square"></i>
                                            @votesAllowed vote@(votesAllowed > 1 ? "s" : "") allowed
                                        </span>
                                        <span class="meta-item">
                                            <i class="bi bi-graph-up"></i>
                                            @totalVotes total votes
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="position-actions">
                                @if (leadingCandidate != null)
                                {
                                    <div class="leading-candidate">
                                        <i class="bi bi-trophy-fill"></i>
                                        <div class="leading-info">
                                            <span class="leading-name">Leading: @leadingCandidate.Name</span>
                                            @if (!string.IsNullOrEmpty(leadingCandidate.PartyList))
                                            {
                                                <span class="leading-party">@leadingCandidate.PartyList</span>
                                            }
                                            <span class="leading-votes">@leadingCandidate.VoteCount votes</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Candidates List -->
                        <div class="candidates-list">
                            @foreach (var candidate in positionGroup.OrderByDescending(c => c.VoteCount))
                            {
                                var votePercentage = totalVotes > 0 ? (candidate.VoteCount * 100.0) / totalVotes : 0;

                                <div class="candidate-item">
                                   
                                    <div class="candidate-avatar">
                                        @if (!string.IsNullOrEmpty(candidate.ProfilePicture))
                                        {
                                            <img src="@candidate.ProfilePicture" alt="@candidate.Name" class="candidate-photo">
                                        }
                                        else
                                        {
                                            <div class="default-avatar">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                        }
                                    </div>

                                    <div class="candidate-info">
                                     
                                        <div class="candidate-header">
                                            <div class="candidate-main-info">
                                                <h4 class="candidate-name">@candidate.Name</h4>
                                                @if (!string.IsNullOrEmpty(candidate.PartyList))
                                                {
                                                    <div class="candidate-party">
                                                     <i class="bi bi-gitlab"></i>
                                                        @candidate.PartyList
                                                    </div>
                                                }
                                            </div>
                                            <div class="candidate-votes">
                                                <span class="vote-count">@candidate.VoteCount</span>
                                                <span class="vote-label">vote@(candidate.VoteCount != 1 ? "s" : "")</span>
                                            </div>
                                        </div>

                                        <p class="candidate-description">
                                            <i class="bi bi-chat-quote"></i>
                                            @candidate.Description
                                        </p>

                                        <div class="vote-progress">
                                            <div class="progress-bar">
                                                <div class="progress-fill" style="width: @votePercentage.ToString("0")%"></div>
                                            </div>
                                            <span class="progress-text">@votePercentage.ToString("0.0")%</span>
                                        </div>
                                    </div>

                                    <div class="candidate-actions">
                                        <a asp-action="Edit" asp-route-id="@candidate.Id" class="action-btn edit-btn" title="Edit Candidate">
                                            <i class="bi bi-feather"></i>
                                            <span>Edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@candidate.Id" class="action-btn delete-btn" title="Delete Candidate">
                                            <i class="bi bi-trash"></i>
                                            <span>Delete</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="statistics-summary">
                <div class="summary-header">
                    <i class="bi bi-bar-chart-fill"></i>
                    <h3>Election Overview</h3>
                </div>
                <div class="stats-grid">
                    <div class="summary-stat">
                        <div class="stat-icon total-candidates">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@Model.Count</span>
                            <span class="stat-label">Total Candidates</span>
                        </div>
                    </div>
                    <div class="summary-stat">
                        <div class="stat-icon total-positions">
                            <i class="bi bi-house-door-fill"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@candidatesByPosition.Count()</span>
                            <span class="stat-label">Positions</span>
                        </div>
                    </div>
                    <div class="summary-stat">
                        <div class="stat-icon total-votes">
                            <i class="bi bi-check-square-fill"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">@Model.Sum(c => c.VoteCount)</span>
                            <span class="stat-label">Total Votes</span>
                        </div>
                    </div>
                    <div class="summary-stat">
                        <div class="stat-icon leading-position">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        <div class="stat-info">
                            @{
                                var mostContested = candidatesByPosition.OrderByDescending(g => g.Count()).FirstOrDefault();
                            }
                            <span class="stat-value">@(mostContested?.Count() ?? 0)</span>
                            <span class="stat-label">Most in @(mostContested?.Key ?? "N/A")</span>
                        </div>
                    </div>
                </div>

                <div class="position-breakdown">
                    <h4>Position Breakdown</h4>
                    <div class="breakdown-grid">
                        @foreach (var positionGroup in candidatesByPosition)
                        {
                            var totalPositionVotes = positionGroup.Sum(c => c.VoteCount);
                            <div class="breakdown-item">
                                <div class="breakdown-header">
                                    <span class="position-name">@positionGroup.Key</span>
                                    <span class="position-count">@positionGroup.Count()</span>
                                </div>
                                <div class="breakdown-stats">
                                    <span class="stat">
                                        <i class="bi bi-people"></i>
                                        @positionGroup.Count() candidates
                                    </span>
                                    <span class="stat">
                                        <i class="bi bi-check-circle"></i>
                                        @totalPositionVotes votes
                                    </span>
                                </div>
                                <div class="breakdown-progress">
                                    @{
                                        var maxVotes = candidatesByPosition.Max(g => g.Sum(c => c.VoteCount));
                                        var widthPercentage = maxVotes > 0 ? (totalPositionVotes * 100) / maxVotes : 0;
                                    }
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @widthPercentage%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>


</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
   
    function initializeVotingButtons() {
        const currentStatus = '@(ViewBag.VotingStatus ?? "Closed")';
        updateVotingStatus(currentStatus);
    }

 
    document.addEventListener('DOMContentLoaded', function() {
        initializeVotingButtons();
    });
    function incrementVotes(button) {
           const input = button.parentElement.querySelector('.votes-allowed-input-enhanced');
           if (parseInt(input.value) < parseInt(input.max)) {
               input.value = parseInt(input.value) + 1;
           }
       }

       function decrementVotes(button) {
           const input = button.parentElement.querySelector('.votes-allowed-input-enhanced');
           if (parseInt(input.value) > parseInt(input.min)) {
               input.value = parseInt(input.value) - 1;
           }
       }

       function resetConfig() {
           const inputs = document.querySelectorAll('.votes-allowed-input-enhanced');
           inputs.forEach(input => {
               input.value = 1;
           });

          
           showToast('Configuration reset to default values', 'success');
       }

    // Toast notification function
    function showToast(message, type) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `toast toast-${type} toast-show`;
        console.log(`${type.toUpperCase()}: ${message}`);

        setTimeout(() => {
            toast.classList.remove('toast-show');
        }, 3000);
    }

    // Voting status controls
    document.getElementById('openVotingBtn').addEventListener('click', openVoting);
    document.getElementById('closeVotingBtn').addEventListener('click', closeVoting);
    document.getElementById('settingsBtn').addEventListener('click', toggleConfigPanel);

        async function openVoting() {
        const openBtn = document.getElementById('openVotingBtn');
        const closeBtn = document.getElementById('closeVotingBtn');

        if (!confirm('Are you sure you want to open voting? This will allow all users to cast their votes.')) {
            return;
        }

        // Show loading state
        openBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Opening...';
        openBtn.disabled = true;

        try {
            const response = await fetch('/Admin/OpenVoting', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const data = await response.json();

            if (response.ok) {
                showToast('✅ Voting has been opened successfully!', 'success');
                updateVotingStatus('Open');
                connection.invoke("SendVotingStatusUpdate", "Open").catch(err => console.error(err));
            } else {
                showToast(`❌ ${data.message}`, 'error');
                // Reset button on error
                openBtn.innerHTML = '<i class="bi bi-circle-fill"></i> Open Voting';
                openBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error opening voting:', error);
            showToast('❌ An error occurred while opening voting', 'error');
            // Reset button on error
            openBtn.innerHTML = '<i class="bi bi-circle-fill"></i> Open Voting';
            openBtn.disabled = false;
        }
    }

    async function closeVoting() {
        const openBtn = document.getElementById('openVotingBtn');
        const closeBtn = document.getElementById('closeVotingBtn');

        if (!confirm('Are you sure you want to close voting? Users will no longer be able to cast or change votes.')) {
            return;
        }

        // Show loading state
        closeBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Closing...';
        closeBtn.disabled = true;

        try {
            const response = await fetch('/Admin/CloseVoting', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const data = await response.json();

            if (response.ok) {
                showToast('🔒 Voting has been closed successfully!', 'success');
                updateVotingStatus('Closed');
                connection.invoke("SendVotingStatusUpdate", "Closed").catch(err => console.error(err));
            } else {
                showToast(`❌ ${data.message}`, 'error');
                // Reset button on error
                closeBtn.innerHTML = '<i class="bi bi-lock-fill"></i> Close Voting';
                closeBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error closing voting:', error);
            showToast('❌ An error occurred while closing voting', 'error');
            // Reset button on error
            closeBtn.innerHTML = '<i class="bi bi-lock-fill"></i> Close Voting';
            closeBtn.disabled = false;
        }
    }

    function updateVotingStatus(status) {
        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');
        const openBtn = document.getElementById('openVotingBtn');
        const closeBtn = document.getElementById('closeVotingBtn');

        if (status === 'Open') {
            statusDot.className = 'status-dot status-open';
            statusText.textContent = 'Voting is Open';

            // Update buttons with proper states
            openBtn.disabled = true;
            openBtn.innerHTML = 'Open Voting';
            closeBtn.disabled = false;
            closeBtn.innerHTML = 'Close Voting';
        } else {
            statusDot.className = 'status-dot status-closed';
            statusText.textContent = 'Voting is Closed';

            // Update buttons with proper states
            openBtn.disabled = false;
            openBtn.innerHTML = 'Open Voting';
            closeBtn.disabled = true;
            closeBtn.innerHTML = 'Close Voting';
        }

        console.log(`Voting status updated to: ${status}`);
        console.log(`Open button disabled: ${openBtn.disabled}`);
        console.log(`Close button disabled: ${closeBtn.disabled}`);
    }

    function toggleConfigPanel() {
        const configPanel = document.getElementById('configPanel');
        configPanel.style.display = configPanel.style.display === 'block' ? 'none' : 'block';
    }

    function closeConfigPanel() {
        document.getElementById('configPanel').style.display = 'none';
    }

           async function saveVotingConfig() {
        const saveBtn = document.getElementById('saveConfigBtn');
        const originalText = saveBtn.innerHTML;

        saveBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
        saveBtn.disabled = true;

        const configs = {};
        const inputs = document.querySelectorAll('.votes-allowed-input-enhanced');

        let validationErrors = [];

        inputs.forEach(input => {
            const position = input.getAttribute('data-position');
            const votesAllowed = parseInt(input.value);
            const candidateCount = parseInt(input.closest('.position-config-card')
                .querySelector('.meta-item').textContent.match(/\d+/)[0]);

            if (votesAllowed > candidateCount) {
                validationErrors.push(`${position}: ${votesAllowed} votes > ${candidateCount} candidates`);
            } else if (votesAllowed > 0) {
                configs[position] = votesAllowed;
            }
        });

        if (validationErrors.length > 0) {
            showToast(` Validation errors: ${validationErrors.join('; ')}`, 'error');
            saveBtn.innerHTML = originalText;
            saveBtn.disabled = false;
            return;
        }

        try {
            const response = await fetch('/Admin/SaveVotingConfig', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(configs)
            });

            const data = await response.json();

            if (response.ok) {
                showToast('✅ Voting configuration saved successfully!', 'success');
                closeConfigPanel();
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(` ${data.message}`, 'error');
                saveBtn.innerHTML = originalText;
                saveBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error saving config:', error);
            showToast(' An error occurred while saving configuration', 'error');
            saveBtn.innerHTML = originalText;
            saveBtn.disabled = false;
        }
    }
    // SignalR connection for real-time updates
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/dashboardHub")
        .build();

    connection.on("ReceiveUpdate", () => {
        console.log("SignalR update received — refreshing dashboard");
        window.location.reload();
    });

    connection.on("VotingStatusChanged", (status) => {
        console.log("Voting status changed to:", status);
        updateVotingStatus(status);
        showToast(`Voting is now ${status}`, 'success');
    });

    connection.start().catch(err => console.error(err.toString()));
</script>
<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #f3f3f3;
        margin: 0;
        padding: 0;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 40px;
        background: #7e57c2;
        color: white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        flex-wrap: wrap;
    }

        .header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

    .logout-button {
        background: #fff;
        color: #7e57c2;
        border: none;
        padding: 10px 20px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .logout-button:hover {
            background: #e0d1f5;
            transform: translateY(-2px);
        }

    .dashboard-container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #fff;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        text-align: center;
        transition: transform 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card.primary {
            border-top: 5px solid #7e57c2;
        }

        .stat-card.success {
            border-top: 5px solid #66bb6a;
        }

        .stat-card.warning {
            border-top: 5px solid #ffa726;
        }

        .stat-card.info {
            border-top: 5px solid #42a5f5;
        }

        .stat-card.danger {
            border-top: 5px solid #ef5350;
        }

    .stat-number {
        font-size: 2.5em;
        font-weight: 700;
