@model List<VotingSystem.Models.CourseStat>

@{
    ViewData["Title"] = "Voting Statistics";
}

<style>
    :root {
        --primary: #7e57c2;
        --primary-dark: #5e35b1;
        --primary-light: #b388ff;
        --secondary: #42a5f5;
        --success: #66bb6a;
        --warning: #ffa726;
        --danger: #ef5350;
        --info: #29b6f6;
        --dark: #37474f;
        --light: #f8f9fa;
        --white: #ffffff;
        --gray: #6c757d;
        --border: #e0e0e0;
        --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.15);
        --gradient-primary: linear-gradient(135deg, #7e57c2 0%, #5e35b1 100%);
        --gradient-success: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%);
        --gradient-warning: linear-gradient(135deg, #ffa726 0%, #ff9800 100%);
        --gradient-info: linear-gradient(135deg, #42a5f5 0%, #2196f3 100%);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        min-height: 100vh;
        color: #333;
        line-height: 1.6;
    }

    /* Header */
    .admin-header {
        background: var(--gradient-primary);
        color: var(--white);
        padding: 1.5rem 2rem;
        box-shadow: var(--shadow-lg);
        position: relative;
        z-index: 100;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .header-title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    .admin-badge {
        background: rgba(255,255,255,0.2);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    .logout-btn {
        background: var(--white);
        color: var(--primary);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow);
    }

        .logout-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            background: #f0f0f0;
        }

    /* Main Container */
    .stats-container {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        position: relative;
    }

    /* Enhanced Overview Cards */
    .overview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--white);
        padding: 2rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        border-left: 4px solid var(--primary);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }

    .stat-primary::before {
        background: var(--gradient-primary);
    }

    .stat-success::before {
        background: var(--gradient-success);
    }

    .stat-warning::before {
        background: var(--gradient-warning);
    }

    .stat-info::before {
        background: var(--gradient-info);
    }

    .stat-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.8rem;
        color: white;
    }

    .stat-primary .stat-icon {
        background: var(--gradient-primary);
    }

    .stat-success .stat-icon {
        background: var(--gradient-success);
    }

    .stat-warning .stat-icon {
        background: var(--gradient-warning);
    }

    .stat-info .stat-icon {
        background: var(--gradient-info);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0.5rem 0;
        display: block;
        color: var(--dark);
    }

    .stat-label {
        color: var(--gray);
        font-size: 0.95rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-trend {
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }

    .trend-up {
        color: var(--success);
    }

    .trend-down {
        color: var(--danger);
    }

    /* Progress Dashboard */
    .progress-dashboard {
        background: var(--white);
        padding: 2rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
        border-left: 4px solid var(--primary);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .dashboard-header h2 {
            color: var(--dark);
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

    .time-filter {
        display: flex;
        gap: 0.5rem;
    }

    .filter-btn {
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        background: var(--white);
        color: var(--gray);
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .filter-btn.active {
            background: var(--primary);
            color: var(--white);
            border-color: var(--primary);
        }

    .progress-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
    }

    .main-progress {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .progress-item {
        background: var(--light);
        padding: 1.5rem;
        border-radius: 12px;
        border-left: 4px solid var(--primary);
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .progress-title {
        font-weight: 600;
        color: var(--dark);
        font-size: 1.1rem;
    }

    .progress-stats {
        color: var(--gray);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .progress-bar-container {
        background: #e9ecef;
        border-radius: 10px;
        height: 12px;
        overflow: hidden;
        position: relative;
    }

    .progress-bar {
        height: 100%;
        border-radius: 10px;
        transition: width 1s ease-in-out;
        position: relative;
    }

    .progress-high {
        background: var(--gradient-success);
    }

    .progress-medium {
        background: var(--gradient-warning);
    }

    .progress-low {
        background: linear-gradient(135deg, #ef5350, #e57373);
    }

    .progress-percentage {
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 0.5rem;
        text-align: right;
    }

    /* Side Stats */
    .side-stats {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .mini-stat {
        background: var(--light);
        padding: 1.25rem;
        border-radius: 12px;
        text-align: center;
        border-left: 4px solid var(--info);
    }

    .mini-stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--dark);
        display: block;
    }

    .mini-stat-label {
        font-size: 0.8rem;
        color: var(--gray);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Enhanced Course Statistics */
    .course-analytics {
        background: var(--white);
        border-radius: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .analytics-header {
        background: var(--gradient-primary);
        color: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .analytics-header h2 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

    .export-actions {
        display: flex;
        gap: 0.75rem;
    }

    .export-btn {
        padding: 0.5rem 1rem;
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        backdrop-filter: blur(10px);
    }

        .export-btn:hover {
            background: rgba(255,255,255,0.3);
        }

    .analytics-content {
        padding: 0;
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

    thead {
        background: var(--light);
    }

    th {
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        color: var(--dark);
        text-align: left;
        border-bottom: 2px solid var(--border);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    tbody tr {
        transition: all 0.3s ease;
    }

        tbody tr:hover {
            background: var(--light);
            transform: scale(1.01);
        }

    .course-name {
        font-weight: 600;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .course-icon {
        width: 32px;
        height: 32px;
        background: var(--gradient-primary);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: white;
    }

    .percentage-cell {
        text-align: center;
    }

    .percentage-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .high-percentage {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .medium-percentage {
        background: #fff3e0;
        color: #ef6c00;
    }

    .low-percentage {
        background: #ffebee;
        color: #c62828;
    }

    .progress-cell {
        min-width: 120px;
    }

    .compact-progress {
        background: #e9ecef;
        border-radius: 10px;
        height: 8px;
        overflow: hidden;
    }

        .compact-progress .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.3s ease;
        }

    /* Charts Section */
    .charts-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .chart-card {
        background: var(--white);
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        border-left: 4px solid var(--primary);
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .chart-header h3 {
            color: var(--dark);
            font-size: 1.2rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .chart-actions {
        display: flex;
        gap: 0.5rem;
    }

    .chart-action-btn {
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--border);
        background: var(--white);
        color: var(--gray);
        border-radius: 4px;
        font-size: 0.75rem;
        cursor: pointer;
    }

    .chart-container {
        height: 250px;
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray);
        font-weight: 600;
        position: relative;
        overflow: hidden;
    }

        .chart-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(126, 87, 194, 0.05), rgba(66, 165, 245, 0.05));
        }

    /* Insights Section */
    .insights-section {
        background: var(--white);
        padding: 2rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
        border-left: 4px solid var(--primary);
    }

    .insights-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

        .insights-header h2 {
            color: var(--dark);
            font-size: 1.5rem;
            font-weight: 700;
        }

    .insights-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .insight-card {
        background: var(--light);
        padding: 1.5rem;
        border-radius: 12px;
        border-left: 4px solid var(--info);
    }

    .insight-title {
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .insight-content {
        color: var(--gray);
        line-height: 1.5;
    }

 
    .back-link {
        display: inline-flex;
        align-items: flex-end;
        margin-left: 1300px;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: var(--primary);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

        .back-link:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow);
            text-decoration: none;
            color: white;
            background: var(--primary-dark);
        }


    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--gray);
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state h3 {
        margin: 0 0 1rem 0;
        color: var(--dark);
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .progress-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .admin-header {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .stats-container {
            padding: 0 1rem;
        }

        .overview-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .charts-section {
            grid-template-columns: 1fr;
        }

        .analytics-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .export-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .stats-table {
            min-width: 600px;
        }
    }

    @@media (max-width: 480px) {
        .overview-grid {
            grid-template-columns: 1fr;
        }

        .insights-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-card, .progress-dashboard, .course-analytics, .chart-card, .insights-section {
        animation: fadeInUp 0.6s ease;
    }

    .stats-table tbody tr {
        animation: fadeInUp 0.4s ease;
    }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="admin-header">
    <div class="header-content">
        <div class="header-title">
            <h1><i class="bi bi-bar-chart-fill"></i> Election Analytics</h1>
            <div class="admin-badge">Voting Statistics & Insights</div>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-btn">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </button>
        </form>
    </div>
</div>
<a href="@Url.Action("Dashboard")" class="back-link">
    <i class="bi bi-arrow-left"></i>
    Back to Dashboard
</a>
<div class="stats-container">
  
    <div class="overview-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="stat-label">Total Registered Users</div>
            <div class="stat-trend trend-up">
                <i class="bi bi-arrow-up"></i>
                Active voters
            </div>
        </div>

        <div class="stat-card stat-success">
            <div class="stat-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-number">@ViewBag.VotedUsers</div>
            <div class="stat-label">Voted Users</div>
            <div class="stat-trend @(ViewBag.VotePercentage >= 50 ? "trend-up" : "trend-down")">
                <i class="bi @(ViewBag.VotePercentage >= 50 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                @ViewBag.VotePercentage% participation
            </div>
        </div>

        <div class="stat-card stat-warning">
            <div class="stat-icon">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div class="stat-number">@(ViewBag.TotalUsers - ViewBag.VotedUsers)</div>
            <div class="stat-label">Pending Votes</div>
            <div class="stat-trend">
                <i class="bi bi-exclamation-circle"></i>
                Remaining
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="stat-number">@ViewBag.VotePercentage%</div>
            <div class="stat-label">Overall Turnout</div>
            <div class="stat-trend @(ViewBag.VotePercentage >= 70 ? "trend-up" : ViewBag.VotePercentage >= 40 ? "" : "trend-down")">
                <i class="bi @(ViewBag.VotePercentage >= 70 ? "bi-trophy" : ViewBag.VotePercentage >= 40 ? "bi-check" : "bi-arrow-down")"></i>
                @(ViewBag.VotePercentage >= 70 ? "Excellent" : ViewBag.VotePercentage >= 40 ? "Good" : "Needs Improvement")
            </div>
        </div>
    </div>

    <!-- Progress Dashboard -->
    <div class="progress-dashboard">
        <div class="dashboard-header">
            <h2><i class="bi bi-graph-up-arrow"></i>
                Voting Progress Dashboard</h2>
            <div class="time-filter">
                <button class="filter-btn active">Live</button>
                <button class="filter-btn">Today</button>
                <button class="filter-btn">Week</button>
                <button class="filter-btn">All Time</button>
            </div>
        </div>

        <div class="progress-grid">
            <div class="main-progress">
                <div class="progress-item">
                    <div class="progress-header">
                        <span class="progress-title">Overall Voting Progress</span>
                        <span class="progress-stats">@ViewBag.VotedUsers of @ViewBag.TotalUsers users voted</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar @(ViewBag.VotePercentage >= 70 ? "progress-high" : ViewBag.VotePercentage >= 40 ? "progress-medium" : "progress-low")"
                             style="width: @ViewBag.VotePercentage%"></div>
                    </div>
                    <div class="progress-percentage">@ViewBag.VotePercentage% Complete</div>
                </div>

                <!-- Additional progress items can be added here -->
                <div class="progress-item">
                    <div class="progress-header">
                        <span class="progress-title">Course Participation</span>
                        <span class="progress-stats">Average across all courses</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar progress-medium" style="width: 65%"></div>
                    </div>
                    <div class="progress-percentage">65% Average</div>
                </div>
            </div>

            <div class="side-stats">
                <div class="mini-stat">
                    <span class="mini-stat-number">@DateTime.Now.ToString("HH:mm")</span>
                    <span class="mini-stat-label">Current Time</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-stat-number">@DateTime.Now.ToString("MMM dd")</span>
                    <span class="mini-stat-label">Election Day</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-stat-number">@(ViewBag.ActiveSessions ?? 0)</span>
                    <span class="mini-stat-label">Active Sessions</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced Course Statistics -->
    <div class="course-analytics">
        <div class="analytics-header">
            <h2><i class="bi bi-list-columns-reverse"></i>
                Course Voting Analytics</h2>
            <div class="export-actions">
                <button class="export-btn" onclick="exportData('csv')">
                    <i class="bi bi-file-earmark-spreadsheet"></i> CSV
                </button>
                <button class="export-btn" onclick="exportData('pdf')">
                    <i class="bi bi-file-pdf"></i> PDF
                </button>
                <button class="export-btn" onclick="printReport()">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>

        <div class="analytics-content">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-book"></i>
                    </div>
                    <h3>No Course Data Available</h3>
                    <p>Course statistics will appear here once voting begins.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Total Students</th>
                                <th>Voted Students</th>
                                <th>Participation Rate</th>
                                <th>Progress</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="course-name">
                                            <div class="course-icon">
                                                <i class="bi bi-mortarboard"></i>
                                            </div>
                                            @course.CourseName
                                        </div>
                                    </td>
                                    <td>@course.TotalStudents</td>
                                    <td>
                                        <strong>@course.VotedStudents</strong>
                                        <div style="font-size: 0.8rem; color: var(--gray);">
                                            @((course.TotalStudents - course.VotedStudents)) remaining
                                        </div>
                                    </td>
                                    <td class="percentage-cell">
                                        <span class="percentage-badge @(course.Percentage >= 70 ? "high-percentage" : course.Percentage >= 40 ? "medium-percentage" : "low-percentage")">
                                            @course.Percentage.ToString("0.0")%
                                        </span>
                                    </td>
                                    <td class="progress-cell">
                                        <div class="compact-progress">
                                            <div class="progress-fill @(course.Percentage >= 70 ? "progress-high" : course.Percentage >= 40 ? "progress-medium" : "progress-low")"
                                                 style="width: @(course.Percentage > 100 ? 100 : course.Percentage)%"></div>
                                        </div>
                                        <div style="font-size: 0.8rem; color: var(--gray); margin-top: 0.25rem;">
                                            @course.VotedStudents/@course.TotalStudents
                                        </div>
                                    </td>
                                    <td>
                                        @if (course.Percentage >= 70)
                                        {
                                            <span style="color: var(--success); font-weight: 600;">
                                                <i class="bi bi-check-circle"></i> Excellent
                                            </span>
                                        }
                                        else if (course.Percentage >= 40)
                                        {
                                            <span style="color: var(--warning); font-weight: 600;">
                                                <i class="bi bi-clock"></i> Good
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--danger); font-weight: 600;">
                                                <i class="bi bi-exclamation-triangle"></i> Low
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

   

    <!-- Insights Section -->
    <div class="insights-section">
        <div class="insights-header">
            <h2> Key Insights & Recommendations</h2>
        </div>
        <div class="insights-grid">
            <div class="insight-card">
                <div class="insight-title">
                    <i class="bi bi-trophy-fill" style="color: var(--success);"></i>
                    Top Performing Course
                </div>
                <div class="insight-content">
                    @{
                        var topCourse = Model.OrderByDescending(c => c.Percentage).FirstOrDefault();
                    }
                    @if (topCourse != null)
                    {
                        <text>
                            <strong>@topCourse.CourseName</strong> leads with <strong>@topCourse.Percentage.ToString("0.0")%</strong> participation rate.
                            @topCourse.VotedStudents out of @topCourse.TotalStudents students have voted.
                        </text>
                    }
                    else
                    {
                        <span>No course data available for analysis.</span>
                    }
                </div>
            </div>

            <div class="insight-card">
                <div class="insight-title">
                    <i class="bi bi-exclamation-triangle-fill" style="color: var(--warning);"></i>
                    Areas for Improvement
                </div>
                <div class="insight-content">
                    @{
                        var lowCourses = Model.Where(c => c.Percentage < 40).ToList();
                    }
                    @if (lowCourses.Any())
                    {
                        <text>
                            <strong>@lowCourses.Count course(s)</strong> have participation below 40%. Consider sending reminders to these groups.
                        </text>
                    }
                    else
                    {
                        <span>All courses are performing well with participation above 40%.</span>
                    }
                </div>
            </div>

            <div class="insight-card">
                <div class="insight-title">
                    <i class="bi bi-clock-fill" style="color: var(--info);"></i>
                    Voting Timeline
                </div>
                <div class="insight-content">
                    @{
                        var votePercentage = ViewBag.VotePercentage ?? 0;
                    }
                    Current overall participation rate is <strong>@votePercentage%</strong>.
                    @if (votePercentage >= 70)
                    {
                        <span>Excellent turnout! The election is highly engaged.</span>
                    }
                    else if (votePercentage >= 40)
                    {
                        <span>Good participation. Consider final reminders for remaining voters.</span>
                    }
                    else
                    {
                        <span>Low participation. Immediate action recommended to boost engagement.</span>
                    }
                </div>
            </div>
        </div>
    </div>

  
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const progressBars = document.querySelectorAll('.progress-bar');
        progressBars.forEach(bar => {
            const width = bar.style.width;
            bar.style.width = '0';
            setTimeout(() => {
                bar.style.width = width;
            }, 500);
        });

      
        const tableRows = document.querySelectorAll('.stats-table tbody tr');
        tableRows.forEach((row, index) => {
            row.style.animationDelay = `${index * 0.1}s`;
        });

        const filterButtons = document.querySelectorAll('.filter-btn');
        filterButtons.forEach(button => {
            button.addEventListener('click', function () {
                filterButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
            });
        });

        window.exportData = function (format) {
            if (format === 'csv') {
                exportToCSV();
            } else if (format === 'pdf') {
                exportToPDF();
            }
        };

        window.printReport = function () {
            window.print();
        };
    });

    // CSV Export Function
    function exportToCSV() {
        try {
            const table = document.querySelector('.stats-table');
            if (!table) {
                alert('No data available to export.');
                return;
            }

            let csv = [];
            const rows = table.querySelectorAll('tr');

            for (let i = 0; i < rows.length; i++) {
                const row = [], cols = rows[i].querySelectorAll('td, th');

                for (let j = 0; j < cols.length; j++) {
                    // Clean the text content - remove icons and extra whitespace
                    let text = cols[j].innerText.trim();
                    text = text.replace(/[\n\r]+/g, ' '); // Replace newlines with spaces
                    text = text.replace(/\s+/g, ' '); // Collapse multiple spaces

                    // Escape quotes and wrap in quotes if contains comma
                    if (text.includes(',') || text.includes('"') || text.includes('\n')) {
                        text = '"' + text.replace(/"/g, '""') + '"';
                    }
                    row.push(text);
                }
                csv.push(row.join(','));
            }

            const csvContent = "data:text/csv;charset=utf-8," + csv.join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `voting-statistics-${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

        } catch (error) {
            console.error('Error exporting CSV:', error);
            alert('Error exporting CSV. Please try again.');
        }
    }

    // PDF Export Function
    function exportToPDF() {
        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

          
            doc.setFontSize(16);
            doc.setTextColor(40, 40, 40);
            doc.text('Voting Statistics Report', 14, 15);

      
            doc.setFontSize(10);
            doc.setTextColor(100, 100, 100);
            doc.text(`Generated on: ${new Date().toLocaleDateString()}`, 14, 22);

        
            doc.setFontSize(12);
            doc.setTextColor(40, 40, 40);
            doc.text(`Total Regular Users: @ViewBag.TotalUsers`, 14, 32);
            doc.text(`Voted Users: @ViewBag.VotedUsers`, 14, 38);
            doc.text(`Participation Rate: @ViewBag.VotePercentage%`, 14, 44);

    
            const table = document.querySelector('.stats-table');
            if (table) {
                const headers = [];
                const rows = [];

      
                const headerRow = table.querySelector('thead tr');
                const headerCells = headerRow.querySelectorAll('th');
                headerCells.forEach(cell => {
                    headers.push(cell.innerText.trim());
                });

          
                const dataRows = table.querySelectorAll('tbody tr');
                dataRows.forEach(row => {
                    const rowData = [];
                    const cells = row.querySelectorAll('td');
                    cells.forEach(cell => {
                        // Clean cell content
                        let text = cell.innerText.trim();
                        text = text.replace(/[\n\r]+/g, ' ');
                        text = text.replace(/\s+/g, ' ');
                        rowData.push(text);
                    });
                    rows.push(rowData);
                });

                // Add table to PDF
                doc.autoTable({
                    head: [headers],
                    body: rows,
                    startY: 50,
                    styles: {
                        fontSize: 9,
                        cellPadding: 3
                    },
                    headStyles: {
                        fillColor: [66, 139, 202],
                        textColor: 255,
                        fontStyle: 'bold'
                    },
                    alternateRowStyles: {
                        fillColor: [245, 245, 245]
                    }
                });
            }

            // Save the PDF
            doc.save(`voting-statistics-${new Date().toISOString().split('T')[0]}.pdf`);

        } catch (error) {
            console.error('Error exporting PDF:', error);
            alert('Error exporting PDF. Please try again.');
        }
    }

    function refreshStatistics() {
        console.log('Refreshing statistics...');
    }

    setInterval(refreshStatistics, 30000);
</script>