@model VotingSystem.Models.Candidate

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Candidate - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        /* Critical Alert Styles - Add these first */
        .global-alert {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            z-index: 10000;
            min-width: 400px;
            max-width: 90%;
            padding: 16px 20px;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.4s ease;
            opacity: 0;
        }

            .global-alert.show {
                transform: translateX(-50%) translateY(20px);
                opacity: 1;
            }

            .global-alert.success {
                background: #4caf50;
                color: white;
                border-left: 4px solid #2e7d32;
            }

            .global-alert.error {
                background: #f44336;
                color: white;
                border-left: 4px solid #c62828;
            }

            .global-alert.warning {
                background: #ff9800;
                color: white;
                border-left: 4px solid #ef6c00;
            }

            .global-alert.info {
                background: #2196f3;
                color: white;
                border-left: 4px solid #1565c0;
            }

        .alert-icon {
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .alert-content {
            flex: 1;
            font-weight: 500;
        }

        .alert-close {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

            .alert-close:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        /* Field Error Styles */
        .field-error {
            display: block;
            color: #f44336;
            font-size: 0.8rem;
            margin-top: 5px;
            padding: 5px 10px;
            background: #ffebee;
            border-radius: 4px;
            border-left: 3px solid #f44336;
            animation: slideIn 0.3s ease;
        }

        .input-error {
            border-color: #f44336 !important;
            box-shadow: 0 0 0 3px rgba(244, 67, 54, 0.1) !important;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Validation Summary */
        .validation-summary {
            background: #ffebee;
            border: 1px solid #f44336;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            animation: slideIn 0.3s ease;
        }

            .validation-summary h4 {
                color: #c62828;
                margin: 0 0 10px 0;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .validation-summary ul {
                margin: 0;
                padding-left: 20px;
                color: #c62828;
            }

            .validation-summary li {
                margin-bottom: 5px;
            }
    </style>
</head>
<body>
    <div class="bg-shape shape1"></div>
    <div class="bg-shape shape2"></div>
    <div class="bg-shape shape3"></div>

    <!-- Global Alert Container -->
    <div id="globalAlert"></div>

    <div class="admin-header">
        <div class="header-content">
            <div class="header-title">
                <h1><i class="bi bi-shield-check"></i> Election Administration</h1>
                <div class="admin-badge">Add Candidate</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>

    <div class="create-container">
        <div class="create-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h2>Add New Candidate</h2>
                <p class="card-subtitle">Create a new candidate for the election ballot</p>
            </div>

            <div class="card-content">
                <!-- Server-side Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        <h4>
                            <i class="bi bi-exclamation-triangle"></i>
                            Please fix the following errors:
                        </h4>
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- TempData Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            showGlobalAlert('@TempData["SuccessMessage"]', 'success');
                        });
                    </script>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            showGlobalAlert('@TempData["ErrorMessage"]', 'error');
                        });
                    </script>
                }

                <div class="content-grid">
                    <!-- Quick Reference Section -->
                    <div class="reference-section">
                        <h3 class="section-title">Quick Reference</h3>

                        <div class="quick-stats">
                            <div class="stat-item">
                                <i class="bi bi-person stat-icon" style="color: var(--primary);"></i>
                                <div class="stat-content">
                                    <div class="stat-label">New Candidate</div>
                                    <div class="stat-desc">Enter full legal name</div>
                                </div>
                            </div>
                            <div class="stat-item">
                                <i class="bi bi-house-door stat-icon" style="color: var(--info);"></i>
                                <div class="stat-content">
                                    <div class="stat-label">Position</div>
                                    <div class="stat-desc">Specific role title</div>
                                </div>
                            </div>
                            <div class="stat-item">
                                <i class="bi bi-people stat-icon" style="color: var(--success);"></i>
                                <div class="stat-content">
                                    <div class="stat-label">Party List</div>
                                    <div class="stat-desc">Political affiliation</div>
                                </div>
                            </div>
                            <div class="stat-item">
                                <i class="bi bi-image stat-icon" style="color: var(--warning);"></i>
                                <div class="stat-content">
                                    <div class="stat-label">Profile Photo</div>
                                    <div class="stat-desc">Professional headshot</div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Tips -->
                        <div class="form-tips">
                            <h4><i class="bi bi-arrow-down-right-circle"></i> Tips for creating effective candidates:</h4>
                            <ul>
                                <li>Use full names for better identification</li>
                                <li>Be specific with position titles</li>
                                <li>Include party affiliation for better organization</li>
                                <li>Upload a clear, professional profile picture</li>
                                <li>Include relevant qualifications and experience</li>
                                <li>Keep descriptions concise but informative</li>
                            </ul>
                        </div>

                        <!-- Requirements Checklist -->
                        <div class="requirements-checklist">
                            <h4><i class="bi bi-check-circle"></i> Required Fields:</h4>
                            <ul>
                                <li class="requirement-item">
                                    <i class="bi bi-check requirement-check"></i>
                                    <span>Candidate Name</span>
                                </li>
                                <li class="requirement-item">
                                    <i class="bi bi-check requirement-check"></i>
                                    <span>Position</span>
                                </li>
                                <li class="requirement-item">
                                    <i class="bi bi-check requirement-check"></i>
                                    <span>Party List</span>
                                </li>
                                <li class="requirement-item">
                                    <i class="bi bi-check requirement-check"></i>
                                    <span>Description</span>
                                </li>
                                <li class="requirement-item">
                                    <i class="bi bi-check requirement-check"></i>
                                    <span>Profile Picture (Recommended)</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Create Form Section -->
                    <div class="create-form-section">
                        <h3 class="section-title">
                            <i class="bi bi-pencil-square"></i>
                            Candidate Details
                        </h3>

                        <form asp-action="Create" method="post" id="createForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-image"></i>
                                    Profile Picture *
                                </label>
                                <div class="profile-upload-container">
                                    <div class="profile-preview" id="profilePreview">
                                        <i class="bi bi-person-circle default-avatar"></i>
                                        <span class="preview-text">No image selected</span>
                                    </div>
                                    <div class="upload-controls">
                                        <input type="file" id="profilePicture" name="profilePicture"
                                               accept="image/*" class="file-input"
                                               onchange="previewImage(this)" />
                                        <label for="profilePicture" class="upload-btn">
                                            <i class="bi bi-cloud-arrow-up"></i>
                                            Choose Image
                                        </label>
                                        <button type="button" class="remove-btn" onclick="removeImage()" style="display: none;">
                                            <i class="bi bi-trash"></i>
                                            Remove
                                        </button>
                                    </div>
                                    <div class="upload-info">
                                        <small>Recommended: Square image, 400x400px, max 2MB</small>
                                    </div>
                                    <span class="field-error" id="profilePictureError" style="display: none;"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="Name">
                                    <i class="bi bi-person-circle"></i>
                                    Candidate Name *
                                </label>
                                <div class="input-with-icon">
                                    <i class="bi bi-person input-icon"></i>
                                    <input asp-for="Name" class="form-input" placeholder="Enter candidate full name" required />
                                </div>
                                <span asp-validation-for="Name" class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="Position">
                                    <i class="bi bi-house-door"></i>
                                    Position *
                                </label>
                                <div class="input-with-icon">
                                    <i class="bi bi-briefcase input-icon"></i>
                                    <input asp-for="Position" class="form-input" placeholder="Enter position title" required />
                                </div>
                                <span asp-validation-for="Position" class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="PartyList">
                                    <i class="bi bi-people"></i>
                                    Party List *
                                </label>
                                <div class="input-with-icon">
                                    <i class="bi bi-flag input-icon"></i>
                                    <input asp-for="PartyList" class="form-input" placeholder="Enter party or group affiliation" />
                                </div>
                                <span asp-validation-for="PartyList" class="field-error"></span>
                            </div>

                            <div class="form-group">
                                <label class="form-label" asp-for="Description">
                                    <i class="bi bi-chat-text"></i>
                                    Description *
                                </label>
                                <textarea asp-for="Description" class="form-input form-textarea"
                                          placeholder="Describe the candidate's qualifications, vision, or platform..."
                                          maxlength="500"></textarea>
                                <div class="char-counter" id="charCounter">0/500 characters</div>
                                <span asp-validation-for="Description" class="field-error"></span>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <i class="bi bi-plus-circle"></i>
                                    Add Candidate
                                </button>
                                <a href="/Admin/Dashboard" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i>
                                    Back to Dashboard
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Global Alert System
        function showGlobalAlert(message, type = 'info') {
            const alertContainer = document.getElementById('globalAlert');
            const alertId = 'alert-' + Date.now();

            const icons = {
                success: 'bi-check-circle',
                error: 'bi-exclamation-circle',
                warning: 'bi-exclamation-triangle',
                info: 'bi-info-circle'
            };

            const alertHTML = `
                <div id="${alertId}" class="global-alert ${type}">
                    <i class="bi ${icons[type] || 'bi-info-circle'} alert-icon"></i>
                    <div class="alert-content">${message}</div>
                    <button class="alert-close" onclick="closeAlert('${alertId}')">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            `;

            alertContainer.innerHTML = alertHTML;

            // Show alert
            setTimeout(() => {
                const alertElement = document.getElementById(alertId);
                if (alertElement) {
                    alertElement.classList.add('show');
                }
            }, 100);

            // Auto hide after 5 seconds
            setTimeout(() => {
                closeAlert(alertId);
            }, 5000);
        }

        function closeAlert(alertId) {
            const alertElement = document.getElementById(alertId);
            if (alertElement) {
                alertElement.classList.remove('show');
                setTimeout(() => {
                    if (alertElement.parentElement) {
                        alertElement.remove();
                    }
                }, 400);
            }
        }

        // Form Validation
        document.addEventListener('DOMContentLoaded', function() {
            initializeFormValidation();
            clearInitialServerErrors(); // Clear any initial server errors on page load
            setupRealTimeValidation();
        });

        function initializeFormValidation() {
            const form = document.getElementById('createForm');

            // Form submission validation
            form.addEventListener('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                    showGlobalAlert('Please fix the validation errors before submitting.', 'error');
                    scrollToFirstError();
                }
            });
        }

        function clearInitialServerErrors() {
            // Clear all error states on page load - only show errors after user interaction
            const allInputs = document.querySelectorAll('.form-input');
            const allErrorSpans = document.querySelectorAll('.field-error');

            allInputs.forEach(input => {
                input.classList.remove('input-error');
            });

            allErrorSpans.forEach(span => {
                span.style.display = 'none';
                span.textContent = '';
            });

         
            const validationSummary = document.querySelector('.validation-summary');
            if (validationSummary) {
                const errors = validationSummary.querySelector('div[asp-validation-summary="All"]');
                if (errors && errors.children.length === 0) {
                    validationSummary.style.display = 'none';
                }
            }
        }

        function setupRealTimeValidation() {
          
            const formInputs = document.querySelectorAll('.form-input');

            formInputs.forEach(input => {
           
                input.addEventListener('input', function() {
                    clearFieldError(this);

                   
                    if (this.hasAttribute('required')) {
                        validateFieldRealTime(this);
                    }
                });

            
                input.addEventListener('blur', function() {
                    if (this.hasAttribute('required')) {
                        validateFieldRealTime(this);
                    }
                });

                if (this.value === '' && this.placeholder) {
                    this.classList.remove('input-error');
                }
            });
        }

        function validateForm() {
            let isValid = true;
            const requiredFields = document.querySelectorAll('.form-input[required]');

            requiredFields.forEach(field => {
                if (!validateFieldRealTime(field)) {
                    isValid = false;
                }
            });

            return isValid;
        }

        function validateFieldRealTime(field) {
            const value = field.value.trim();
            const errorElement = getErrorElement(field);

            // Don't validate empty fields until user has interacted with them
            if (!value && !field.dataset.interacted) {
                return true; // Don't show error for untouched empty fields
            }

            if (!value) {
                showFieldError(field, `${getFieldDisplayName(field)} is required`);
                return false;
            }

            // Additional validation for specific fields
            if (field.name === 'Name' && value.length < 2) {
                showFieldError(field, 'Candidate name must be at least 2 characters long');
                return false;
            }

            if (field.name === 'Position' && value.length < 2) {
                showFieldError(field, 'Position must be at least 2 characters long');
                return false;
            }

            // Clear any errors if field is valid
            clearFieldError(field);
            return true;
        }

        function showFieldError(field, message) {
            // Mark field as interacted
            field.dataset.interacted = 'true';

            // Add error styling to input
            field.classList.add('input-error');

            // Show error message
            const errorElement = getErrorElement(field);
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.style.display = 'block';
            }
        }

        function clearFieldError(field) {
            // Remove error styling
            field.classList.remove('input-error');

            // Hide error message
            const errorElement = getErrorElement(field);
            if (errorElement) {
                errorElement.textContent = '';
                errorElement.style.display = 'none';
            }
        }

        function getErrorElement(field) {
            // Try to find the error element next to the input
            const parentFormGroup = field.closest('.form-group');
            if (parentFormGroup) {
                const errorElement = parentFormGroup.querySelector('.field-error');
                if (errorElement) {
                    return errorElement;
                }
            }

            // Fallback: try to find by ID
            return document.getElementById(field.name + 'Error');
        }

        function getFieldDisplayName(field) {
            const names = {
                'Name': 'Candidate name',
                'Position': 'Position',
                'PartyList': 'Party list',
                'Description': 'Description',
                'profilePicture': 'Profile picture'
            };
            return names[field.name] || field.name;
        }

        function scrollToFirstError() {
            const firstError = document.querySelector('.input-error');
            if (firstError) {
                firstError.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
                firstError.focus();
            }
        }

        // Character counter
        const descriptionTextarea = document.querySelector('textarea[name="Description"]');
        const charCounter = document.getElementById('charCounter');

        if (descriptionTextarea && charCounter) {
            function updateCharCount() {
                const length = descriptionTextarea.value.length;
                charCounter.textContent = `${length}/500 characters`;

                if (length > 450) {
                    charCounter.className = 'char-counter danger';
                } else if (length > 400) {
                    charCounter.className = 'char-counter warning';
                } else {
                    charCounter.className = 'char-counter';
                }
            }

            descriptionTextarea.addEventListener('input', updateCharCount);
            updateCharCount();
        }

        // Profile picture handling
        function previewImage(input) {
            const preview = document.getElementById('profilePreview');
            const removeBtn = document.querySelector('.remove-btn');
            const errorElement = document.getElementById('profilePictureError');
            const file = input.files[0];

            // Clear previous errors
            if (errorElement) {
                errorElement.style.display = 'none';
                errorElement.textContent = '';
            }

            if (file) {
                // Validate file size
                if (file.size > 2 * 1024 * 1024) {
                    showGlobalAlert('File size must be less than 2MB', 'error');
                    if (errorElement) {
                        errorElement.textContent = 'File size must be less than 2MB';
                        errorElement.style.display = 'block';
                    }
                    input.value = '';
                    return;
                }

                // Validate file type
                if (!file.type.startsWith('image/')) {
                    showGlobalAlert('Please select an image file (JPG, PNG, GIF)', 'error');
                    if (errorElement) {
                        errorElement.textContent = 'Please select an image file';
                        errorElement.style.display = 'block';
                    }
                    input.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview" class="profile-image">`;
                    preview.classList.add('has-image');
                    removeBtn.style.display = 'block';
                    showGlobalAlert('Profile picture selected successfully', 'success');
                }
                reader.onerror = function() {
                    showGlobalAlert('Error reading the image file', 'error');
                }
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            const input = document.getElementById('profilePicture');
            const preview = document.getElementById('profilePreview');
            const removeBtn = document.querySelector('.remove-btn');
            const errorElement = document.getElementById('profilePictureError');

            input.value = '';
            preview.innerHTML = '<i class="bi bi-person-circle default-avatar"></i><span class="preview-text">No image selected</span>';
            preview.classList.remove('has-image');
            removeBtn.style.display = 'none';

            if (errorElement) {
                errorElement.style.display = 'none';
                errorElement.textContent = '';
            }

            showGlobalAlert('Profile picture removed', 'info');
        }

        // Input effects - only for visual enhancement, not validation
        const inputs = document.querySelectorAll('.form-input');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                if (!this.classList.contains('input-error')) {
                    this.style.transform = 'translateY(-2px)';
                    this.style.boxShadow = '0 4px 12px rgba(126, 87, 194, 0.15)';
                }
            });

            input.addEventListener('blur', function() {
                if (!this.classList.contains('input-error')) {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                }
            });

            // Mark field as interacted when user focuses on it
            input.addEventListener('focus', function() {
                this.dataset.interacted = 'true';
            });
        });
    </script>
</body>
</html>

<style>
    :root {
        --primary: #7e57c2;
        --primary-dark: #5e35b1;
        --primary-light: #b388ff;
        --secondary: #42a5f5;
        --success: #66bb6a;
        --warning: #ffa726;
        --danger: #ef5350;
        --info: #29b6f6;
        --dark: #37474f;
        --light: #f8f9fa;
        --white: #ffffff;
        --gray: #6c757d;
        --border: #e0e0e0;
        --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        min-height: 100vh;
        color: #333;
        line-height: 1.6;
        position: relative;
        overflow-x: hidden;
    }

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        opacity: 0.1;
        z-index: 0;
        animation: float 8s infinite ease-in-out;
    }

    .shape1 {
        width: 300px;
        height: 300px;
        background: linear-gradient(45deg, var(--primary), var(--primary-light));
        top: 10%;
        left: 5%;
    }

    .shape2 {
        width: 200px;
        height: 200px;
        background: linear-gradient(45deg, var(--success), #81c784);
        bottom: 20%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape3 {
        width: 150px;
        height: 150px;
        background: linear-gradient(45deg, var(--info), #64b5f6);
        top: 50%;
        left: 80%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-20px) rotate(180deg);
        }
    }

    .admin-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: var(--white);
        padding: 1.5rem 2rem;
        box-shadow: var(--shadow-lg);
        position: relative;
        z-index: 100;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .header-title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    .admin-badge {
        background: rgba(255,255,255,0.2);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    .logout-btn {
        background: var(--white);
        color: var(--primary);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
