@model Election
@{
    ViewBag.Title = "Create New Election";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Election - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="bg-shape shape1"></div>
    <div class="bg-shape shape2"></div>
    <div class="bg-shape shape3"></div>

    <!-- Admin Header -->
    <div class="admin-header">
        <div class="header-content">
            <div class="header-title">
                <h1><i class="bi bi-shield-check"></i> Election Administration</h1>
                <div class="admin-badge">Create New Election</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>

    <div class="dashboard-container">
        <!-- Toast Notification -->
        <div id="toast" class="toast"></div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">
                <i class="bi bi-plus-circle"></i>
                Create New Election
            </h1>
            <div class="header-actions">
                <a href="@Url.Action("ElectionManagement")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Elections
                </a>
            </div>
        </div>

        <!-- Election Creation Form -->
        <div class="form-card">
            <div class="form-header">
                <h3> Election Details</h3>
                <p>Fill in the details below to create a new election</p>
            </div>

            <form asp-action="CreateElection" method="post" class="election-form">
                @Html.AntiForgeryToken()

                <div class="form-section">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag"></i> Election Name *
                        </label>
                        <input asp-for="Name" class="form-control"
                               placeholder="Enter a descriptive election name"
                               required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <div class="form-hint">This will be displayed to voters</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-text-paragraph"></i> Description
                        </label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="4"
                                  placeholder="Describe the purpose and scope of this election"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <div class="form-hint">Provide context about this election for voters</div>
                    </div>
                </div>

                <div class="form-section">
                    <h4><i class="bi bi-calendar-event"></i> Election Period</h4>
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="StartDate" class="form-label">
                                <i class="bi bi-play-circle"></i> Start Date *
                            </label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                            <div class="form-hint">When voting will begin</div>
                        </div>

                        <div class="form-group">
                            <label asp-for="EndDate" class="form-label">
                                <i class="bi bi-stop-circle"></i> End Date *
                            </label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                            <div class="form-hint">When voting will end</div>
                        </div>
                    </div>
                </div>

                <!-- Election Preview -->
                <div class="form-section preview-section">
                    <h4><i class="bi bi-eye"></i> Election Preview</h4>
                    <div class="election-preview">
                        <div class="preview-header">
                            <h5 id="previewName">Election Name</h5>
                            <span class="status-badge upcoming">Upcoming</span>
                        </div>
                        <p id="previewDescription" class="preview-description">Election description will appear here</p>
                        <div class="preview-dates">
                            <div class="date-item">
                                <i class="bi bi-play-circle"></i>
                                <strong>Start:</strong> <span id="previewStartDate">Not set</span>
                            </div>
                            <div class="date-item">
                                <i class="bi bi-stop-circle"></i>
                                <strong>End:</strong> <span id="previewEndDate">Not set</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Create Election
                    </button>
                    <a href="@Url.Action("ElectionManagement")" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Set minimum datetime to current time
        const now = new Date();
        const timezoneOffset = now.getTimezoneOffset() * 60000;
        const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);

        document.getElementById('StartDate').min = localISOTime;
        document.getElementById('EndDate').min = localISOTime;

        // Update EndDate min when StartDate changes
        document.getElementById('StartDate').addEventListener('change', function() {
            document.getElementById('EndDate').min = this.value;
            updatePreview();
        });

        document.getElementById('EndDate').addEventListener('change', updatePreview);

        // Real-time preview updates
        document.getElementById('Name').addEventListener('input', updatePreview);
        document.getElementById('Description').addEventListener('input', updatePreview);

        function updatePreview() {
            // Update name
            const name = document.getElementById('Name').value || 'Election Name';
            document.getElementById('previewName').textContent = name;

            // Update description
            const description = document.getElementById('Description').value || 'Election description will appear here';
            document.getElementById('previewDescription').textContent = description;

            // Update dates
            const startDate = document.getElementById('StartDate').value;
            const endDate = document.getElementById('EndDate').value;

            if (startDate) {
                const start = new Date(startDate);
                document.getElementById('previewStartDate').textContent = start.toLocaleString();
            } else {
                document.getElementById('previewStartDate').textContent = 'Not set';
            }

            if (endDate) {
                const end = new Date(endDate);
                document.getElementById('previewEndDate').textContent = end.toLocaleString();
            } else {
                document.getElementById('previewEndDate').textContent = 'Not set';
            }

            // Validate date logic
            if (startDate && endDate) {
                const start = new Date(startDate);
                const end = new Date(endDate);

                if (end <= start) {
                    document.getElementById('EndDate').setCustomValidity('End date must be after start date');
                } else {
                    document.getElementById('EndDate').setCustomValidity('');
                }
            }
        }

        // Initialize preview
        updatePreview();

        // Toast notification function
        function showToast(message, type) {
            const toast = document.getElementById('toast');
            if (toast) {
                toast.textContent = message;
                toast.className = `toast toast-${type} toast-show`;
                setTimeout(() => {
                    toast.classList.remove('toast-show');
                }, 3000);
            }
        }

        // Form submission enhancement
        document.querySelector('.election-form').addEventListener('submit', function(e) {
            const startDate = new Date(document.getElementById('StartDate').value);
            const endDate = new Date(document.getElementById('EndDate').value);

            if (endDate <= startDate) {
                e.preventDefault();
                showToast('❌ End date must be after start date', 'error');
                return false;
            }

            showToast('⏳ Creating election...', 'success');
            return true;
        });
    </script>
</body>
</html>

<style>
    /* Reuse your existing CSS variables and base styles */
    :root {
        --primary: #7e57c2;
        --primary-dark: #5e35b1;
        --primary-light: #b388ff;
        --secondary: #42a5f5;
        --success: #66bb6a;
        --warning: #ffa726;
        --danger: #ef5350;
        --info: #29b6f6;
        --dark: #37474f;
        --light: #f8f9fa;
        --white: #ffffff;
        --gray: #6c757d;
        --border: #e0e0e0;
        --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        min-height: 100vh;
        color: #333;
        line-height: 1.6;
    }

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        opacity: 0.1;
        z-index: 0;
        animation: float 8s infinite ease-in-out;
    }

    .shape1 {
        width: 300px;
        height: 300px;
        background: linear-gradient(45deg, var(--primary), var(--primary-light));
        top: 10%;
        left: 5%;
    }

    .shape2 {
        width: 200px;
        height: 200px;
        background: linear-gradient(45deg, var(--success), #81c784);
        bottom: 20%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape3 {
        width: 150px;
        height: 150px;
        background: linear-gradient(45deg, var(--info), #64b5f6);
        top: 50%;
        left: 80%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-20px) rotate(180deg);
        }
    }

    /* Reuse your existing header styles */
    .admin-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: var(--white);
        padding: 1.5rem 2rem;
        box-shadow: var(--shadow-lg);
        position: relative;
        z-index: 100;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .header-title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    .admin-badge {
        background: rgba(255,255,255,0.2);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    .logout-btn {
        background: var(--white);
        color: var(--primary);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow);
    }

        .logout-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            background: #f0f0f0;
        }

    .dashboard-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 10;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .dashboard-title i {
            color: var(--primary);
        }

    .header-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        justify-content: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: var(--shadow);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            background: linear-gradient(135deg, var(--primary-dark), #4a148c);
        }

    .btn-secondary {
        background: var(--light);
        color: var(--dark);
        border: 2px solid var(--border);
    }

        .btn-secondary:hover {
            background: var(--white);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
            border-color: var(--primary-light);
        }

    .btn-lg {
        padding: 1.25rem 2.5rem;
        font-size: 1.1rem;
    }

    /* Form Styles */
    .form-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .form-header {
        background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
        color: var(--white);
        padding: 2rem;
    }

        .form-header h3 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .form-header p {
            opacity: 0.9;
            margin: 0;
        }

    .election-form {
        padding: 2rem;
    }

    .form-section {
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
    }

        .form-section:last-of-type {
            border-bottom: none;
            margin-bottom: 1rem;
        }

        .form-section h4 {
            color: var(--dark);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.2rem;
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 1rem 1.25rem;
        border: 2px solid var(--border);
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--white);
    }

        .form-control:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(126, 87, 194, 0.1);
        }

        .form-control:invalid {
            border-color: var(--danger);
        }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
    }

    .form-hint {
        font-size: 0.85rem;
        color: var(--gray);
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .text-danger {
        color: var(--danger);
        font-size: 0.9rem;
        margin-top: 0.5rem;
        display: block;
    }

    /* Preview Section */
    .preview-section {
        background: var(--light);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
    }

    .election-preview {
        background: var(--white);
        padding: 1.5rem;
        border-radius: 8px;
        border: 2px dashed var(--border);
    }

    .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

        .preview-header h5 {
            margin: 0;
            color: var(--dark);
            font-size: 1.2rem;
            flex: 1;
            margin-right: 1rem;
        }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        white-space: nowrap;
    }

        .status-badge.upcoming {
            background: var(--warning);
            color: white;
        }

    .preview-description {
        color: var(--gray);
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .preview-dates {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .date-item {
        font-size: 0.9rem;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .date-item i {
            color: var(--primary);
        }

    /* Form Actions */
    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-start;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }

    /* Alert Styles */
    .alert {
        padding: 1rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border-left: 4px solid;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border-color: var(--success);
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border-color: var(--danger);
    }

    /* Toast Styles */
    .toast {
        position: fixed;
        top: 100px;
        right: 20px;
        padding: 15px 20px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        z-index: 1000;
        opacity: 0;
        transform: translateX(100%);
        transition: all 0.3s ease;
    }

    .toast-success {
        background: var(--success);
    }

    .toast-error {
        background: var(--danger);
    }

    .toast-show {
        opacity: 1;
        transform: translateX(0);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 0 1rem;
        }

        .dashboard-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            justify-content: space-between;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }

        .preview-dates {
            flex-direction: column;
            gap: 1rem;
        }

        .preview-header {
            flex-direction: column;
            gap: 1rem;
        }

        .status-badge {
            align-self: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .admin-header {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            gap: 1rem;
        }

        .form-card {
            margin: 0 -1rem;
            border-radius: 0;
        }

        .election-form {
            padding: 1.5rem;
        }
    }
</style>