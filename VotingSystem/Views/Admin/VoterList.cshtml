@model List<User>

@{
    ViewData["Title"] = "Voter List";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voter Management - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .profile-picture {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary);
        }

        .profile-picture-placeholder {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            border: 2px solid var(--primary);
        }

        .user-info-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .username {
            font-weight: 600;
            color: var(--text-dark);
        }

        .user-meta {
            font-size: 0.8em;
            color: var(--text-light);
            margin-top: 0.25rem;
        }
    </style>
</head>
<body>
    <div class="bg-shape shape1"></div>
    <div class="bg-shape shape2"></div>
    <div class="bg-shape shape3"></div>

    <div class="admin-header">
        <div class="header-content">
            <div class="header-title">
                <h1><i class="bi bi-shield-check"></i> Election Administration</h1>
                <div class="admin-badge">Voter Management</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>
    <a href="@Url.Action("Dashboard")" class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Dashboard
    </a>
    <div class="voter-container">
        <div class="filter-section">
            <div class="filter-header">
                <i class="bi bi-funnel"></i>
                <h3>Filter Voters</h3>
            </div>
            <div class="filter-controls">
                <form method="get" class="filter-form">
                    <select name="courseFilter" class="filter-select" onchange="this.form.submit()">
                        <option value="">All Courses</option>
                        @foreach (var course in ViewBag.Courses)
                        {
                            <option value="@course" selected="@(ViewBag.CourseFilter == course)">@course</option>
                        }
                    </select>
                </form>
                @if (!string.IsNullOrEmpty(ViewBag.CourseFilter))
                {
                    <div class="current-filter">
                        <i class="bi bi-eye"></i>
                        Currently viewing: @ViewBag.CourseFilter
                        <a href="@Url.Action("VoterList")" class="clear-filter">
                            <i class="bi bi-x"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="stats-grid">
            <div class="stat-card stat-total">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-number">@ViewBag.TotalVoters</div>
                <div class="stat-label">Total Voters</div>
                <div class="stat-percentage">100%</div>
            </div>

            <div class="stat-card stat-voted">
                <div class="stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-number">@ViewBag.VotedCount</div>
                <div class="stat-label">Voted</div>
                <div class="stat-percentage">
                    @((ViewBag.TotalVoters > 0 ? (ViewBag.VotedCount / (double)ViewBag.TotalVoters * 100) : 0).ToString("0.0"))%
                </div>
            </div>

            <div class="stat-card stat-not-voted">
                <div class="stat-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="stat-number">@(ViewBag.TotalVoters - ViewBag.VotedCount)</div>
                <div class="stat-label">Not Voted</div>
                <div class="stat-percentage">
                    @((ViewBag.TotalVoters > 0 ? ((ViewBag.TotalVoters - ViewBag.VotedCount) / (double)ViewBag.TotalVoters * 100) : 0).ToString("0.0"))%
                </div>
            </div>

            <div class="stat-card stat-approved">
                <div class="stat-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="stat-number">@Model.Count(u => u.IsApproved && u.Role != "Admin")</div>
                <div class="stat-label">Approved Voters</div>
                <div class="stat-percentage">
                    @{
                        var totalUsersInView = Model.Count;
                        var approvedVotersCount = Model.Count(u => u.IsApproved && u.Role != "Admin");
                        var approvedPercentage = totalUsersInView > 0 ? (approvedVotersCount / (double)totalUsersInView * 100) : 0;
                    }
                    @approvedPercentage.ToString("0.0")%
                </div>
            </div>

            <div class="stat-card stat-pending">
                <div class="stat-icon">
                    <i class="bi bi-person-x"></i>
                </div>
                <div class="stat-number">@ViewBag.PendingCount</div>
                <div class="stat-label">Pending Approval</div>
                <div class="stat-percentage">
                    @{
                        var totalAllUsers = ViewBag.TotalVoters + ViewBag.PendingCount;
                        var pendingPercentage = totalAllUsers > 0 ? (ViewBag.PendingCount / (double)totalAllUsers * 100) : 0;
                    }
                    @pendingPercentage.ToString("0.0")%
                </div>
            </div>
        </div>

        <!-- Search Section -->
        <div class="search-section">
            <div class="search-header">
                <i class="bi bi-search"></i>
                <h3>Search Voters</h3>
            </div>
            <div class="search-controls">
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Search by username, email, or course..."
                           class="search-input">
                    <button type="button" id="searchBtn" class="search-btn">
                        <i class="bi bi-search"></i>
                        Search
                    </button>
                    <button type="button" id="clearSearch" class="clear-btn">
                        <i class="bi bi-x-circle"></i>
                        Clear
                    </button>
                </div>
                <div class="search-results-info" id="searchResultsInfo" style="display: none;">
                    <i class="bi bi-info-circle"></i>
                    <span id="resultsText"></span>
                </div>
            </div>
        </div>

        <!-- Voter Table -->
        <div class="table-section">
            <div class="table-header">
                <h3>
                    <i class="bi bi-people-fill"></i>
                    Voter Directory
                </h3>
                <div class="table-actions">
                    <div style="color: rgba(255,255,255,0.8); font-size: 0.9rem;">
                        <i class="bi bi-info-circle"></i>
                        Manage voter accounts and permissions
                    </div>
                </div>
            </div>

            <div class="table-container">
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <h3>No Voters Found</h3>
                        <p>No voters match your current filter criteria.</p>
                    </div>
                }
                else
                {
                    <table id="votersTable">
                        <thead>
                            <tr>
                                <th>User Information</th>
                                <th>Contact</th>
                                <th>Course</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Voting Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="votersTableBody">
                            @foreach (var user in Model)
                            {
                                <tr class="voter-row @(!user.IsApproved ? "pending-user" : "")"
                                    data-username="@user.Username.ToLower()"
                                    data-email="@user.Email.ToLower()"
                                    data-course="@user.Course.ToLower()">
                                    <td>
                                        <div class="user-info-container">
                                            @if (!string.IsNullOrEmpty(user.ProfilePicture) && user.ProfilePicture != "/images/default-avatar.png")
                                            {
                                                <img src="@user.ProfilePicture" alt="Profile" class="profile-picture"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            }
                                            <div class="profile-picture-placeholder"
                                                 style="@(!string.IsNullOrEmpty(user.ProfilePicture) && user.ProfilePicture != "/images/default-avatar.png" ? "display: none;" : "display: flex;")">
                                                @user.Username.Substring(0, 1).ToUpper()
                                            </div>
                                            <div class="user-details">
                                                <strong class="username">@user.Username</strong>
                                                @if (!user.IsApproved)
                                                {
                                                    <div class="user-meta" style="color: var(--warning);">
                                                        <i class="bi bi-clock"></i> Awaiting Approval
                                                    </div>
                                                }
                                                <div class="user-meta">
                                                    Joined: @user.CreatedAt.ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="email">@user.Email</td>
                                    <td>
                                        <span style="font-weight: 600; color: var(--primary);" class="course">@user.Course</span>
                                    </td>
                                    <td>
                                        <span class="badge @(user.Role == "Admin" ? "badge-admin" : "badge-user")">
                                            <i class="bi @(user.Role == "Admin" ? "bi-shield-check" : "bi-person")"></i>
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(user.IsApproved ? "badge-approved" : "badge-pending")">
                                            <i class="bi @(user.IsApproved ? "bi-check-circle" : "bi-clock")"></i>
                                            @(user.IsApproved ? "Approved" : "Pending")
                                        </span>
                                    </td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge badge-admin">
                                                <i class="bi bi-person-gear"></i>
                                                Manager
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge @(user.HasVoted ? "badge-voted" : "badge-not-voted")">
                                                <i class="bi @(user.HasVoted ? "bi-check-circle" : "bi-x-circle")"></i>
                                                @(user.HasVoted ? "Voted" : "Not Voted")
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            @if (!user.IsApproved)
                                            {
                                                <form asp-action="ApproveUser" method="post" style="display: inline;">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="action-btn btn-approve" title="Approve User">
                                                        <i class="bi bi-check-lg"></i>
                                                        Approve
                                                    </button>
                                                </form>
                                                <form asp-action="RejectUser" method="post" style="display: inline;">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="action-btn btn-reject" title="Reject User"
                                                            onclick="return confirm('Are you sure you want to reject this user? This will delete their account.');">
                                                        <i class="bi bi-x-lg"></i>
                                                        Reject
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="DeleteUser" method="post" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="action-btn btn-delete" title="Delete User"
                                                            onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                        <i class="bi bi-trash"></i>
                                                        Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const clearSearch = document.getElementById('clearSearch');
            const votersTableBody = document.getElementById('votersTableBody');
            const searchResultsInfo = document.getElementById('searchResultsInfo');
            const resultsText = document.getElementById('resultsText');
            const voterRows = document.querySelectorAll('.voter-row');
            const originalCount = voterRows.length;

            console.log('Search initialized. Total voters:', originalCount);

            // Initial animation for all rows
            animateRows(voterRows);

            // Search function
            function performSearch() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                console.log('Searching for:', searchTerm);

                if (searchTerm === '') {
                    clearSearchResults();
                    return;
                }

                let visibleCount = 0;

                voterRows.forEach(row => {
                    const username = row.getAttribute('data-username') || '';
                    const email = row.getAttribute('data-email') || '';
                    const course = row.getAttribute('data-course') || '';

                    const matches = username.includes(searchTerm) ||
                                   email.includes(searchTerm) ||
                                   course.includes(searchTerm);

                    if (matches) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Update results info
                if (searchTerm) {
                    resultsText.textContent = `Found ${visibleCount} voter(s) matching "${searchTerm}"`;
                    searchResultsInfo.style.display = 'flex';
                } else {
                    searchResultsInfo.style.display = 'none';
                }

                // Re-animate visible rows
                const visibleRows = document.querySelectorAll('.voter-row[style=""]');
                animateRows(visibleRows);
            }

            function clearSearchResults() {
                console.log('Clearing search');
                searchInput.value = '';
                voterRows.forEach(row => {
                    row.style.display = '';
                });
                searchResultsInfo.style.display = 'none';
                animateRows(voterRows);
            }

            function animateRows(rows) {
                rows.forEach((row, index) => {
                    row.style.animationDelay = `${index * 0.05}s`;
                    row.style.animation = 'fadeIn 0.6s ease forwards';
                    row.style.opacity = '0';
                });
            }

            searchBtn.addEventListener('click', performSearch);
            clearSearch.addEventListener('click', clearSearchResults);

            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    performSearch();
                }
            });

            searchInput.addEventListener('input', function() {
                if (this.value.length >= 2 || this.value.length === 0) {
                    performSearch();
                }
            });
        });
    </script>
</body>
</html>
<style>
    :root {
        --primary: #7e57c2;
        --primary-dark: #5e35b1;
        --primary-light: #b388ff;
        --secondary: #42a5f5;
        --success: #66bb6a;
        --warning: #ffa726;
        --danger: #ef5350;
        --info: #29b6f6;
        --dark: #37474f;
        --light: #f8f9fa;
        --white: #ffffff;
        --gray: #6c757d;
        --border: #e0e0e0;
        --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        min-height: 100vh;
        color: #333;
        line-height: 1.6;
        position: relative;
        overflow-x: hidden;
    }

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        opacity: 0.1;
        z-index: 0;
        animation: float 8s infinite ease-in-out;
    }

    .shape1 {
        width: 300px;
        height: 300px;
        background: linear-gradient(45deg, var(--primary), var(--primary-light));
        top: 10%;
        left: 5%;
    }

    .shape2 {
        width: 200px;
        height: 200px;
        background: linear-gradient(45deg, var(--success), #81c784);
        bottom: 20%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape3 {
        width: 150px;
        height: 150px;
        background: linear-gradient(45deg, var(--info), #64b5f6);
        top: 50%;
        left: 80%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-20px) rotate(180deg);
        }
    }

    .admin-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: var(--white);
        padding: 1.5rem 2rem;
        box-shadow: var(--shadow-lg);
        position: relative;
        z-index: 100;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .header-title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

    .admin-badge {
        background: rgba(255,255,255,0.2);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    .logout-btn {
        background: var(--white);
        color: var(--primary);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow);
    }

        .logout-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            background: #f0f0f0;
        }

    .voter-container {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 10;
    }

    .filter-section {
        background: var(--white);
        padding: 2rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
        border-left: 4px solid var(--primary);
    }

    .filter-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

        .filter-header h3 {
            margin: 0;
            color: var(--dark);
            font-size: 1.3rem;
        }

    .filter-controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-select {
        padding: 0.75rem 1rem;
        border: 2px solid var(--border);
        border-radius: 8px;
        font-size: 0.95rem;
        background: var(--white);
        color: var(--dark);
        font-weight: 500;
        transition: all 0.3s ease;
        min-width: 200px;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(126, 87, 194, 0.1);
        }

    .current-filter {
        background: var(--primary);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--white);
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow);
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        border-left: 4px solid var(--primary);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--primary-light));
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
        color: white;
    }

    .stat-total .stat-icon {
        background: var(--primary);
    }

    .stat-voted .stat-icon {
        background: var(--success);
    }

    .stat-not-voted .stat-icon {
        background: var(--warning);
    }

    .stat-approved .stat-icon {
        background: var(--info);
    }

    .stat-pending .stat-icon {
        background: var(--danger);
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0.5rem 0;
        display: block;
        color: var(--dark);
    }

    .stat-label {
        color: var(--gray);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-percentage {
        font-size: 1rem;
        font-weight: 700;
        color: var(--success);
        margin-top: 0.5rem;
    }
    .table-section {
        background: var(--white);
        border-radius: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .table-header {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: white;
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .table-header h3 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

    .table-count {
        background: rgba(255,255,255,0.2);
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .table-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

    thead {
        background: var(--light);
    }

    th {
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: var(--dark);
        text-align: left;
        border-bottom: 2px solid var(--border);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
        font-weight: 500;
    }

    tbody tr {
        transition: all 0.3s ease;
    }

        tbody tr:hover {
            background: var(--light);
            transform: scale(1.01);
        }

        tbody tr.pending-user {
            background: #fff5f5;
        }

            tbody tr.pending-user:hover {
                background: #ffeaea;
            }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-approved {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
